gunicorn_status() {
  s6_service_status "gunicorn"
}
db_configure_odbc() {
  load_env

  info "Configuring ODBC from .env settings..."

  # Check template exists
  TEMPLATE_FILE="/workspace/.toolchain/prototype/odbc/odbc.ini.template"
  if [ ! -f "$TEMPLATE_FILE" ]; then
    error "ODBC template not found: $TEMPLATE_FILE"
  fi

  # Read template
  ODBC_CONTENT=$(cat "$TEMPLATE_FILE")

  # Extract database path from SQLITE3_CONNECTION (file:/path/to/db.db)
  SQLITE3_PATH=$(echo "$SQLITE3_CONNECTION" | sed 's|^file:||')

  # Extract host from MariaDB connection string
  MARIADB_HOST=$(echo "$MARIADB_CONNECTION" | grep -oP 'host=\K[^,]+' | head -1)
  MARIADB_PORT=$(echo "$MARIADB_CONNECTION" | grep -oP 'port=\K[^,]+' | head -1)

  # Extract host from PostgreSQL connection string
  PGSQL_HOST=$(echo "$PGSQL_CONNECTION" | grep -oP 'host=\K[^,\s]+' | head -1)
  PGSQL_PORT=$(echo "$PGSQL_CONNECTION" | grep -oP 'port=\K[^,\s]+' | head -1)

  # Set defaults if not found
  MARIADB_HOST=${MARIADB_HOST:-$MARIADB_CONTAINER}
  MARIADB_PORT=${MARIADB_PORT:-3306}
  PGSQL_HOST=${PGSQL_HOST:-$PGSQL_CONTAINER}
  PGSQL_PORT=${PGSQL_PORT:-5432}

  # Generate generic DSN configuration based on enabled database
  if [ "$PGSQL_ENABLED" = "y" ]; then
    GENERIC_DSN_CONFIG="Driver=PostgreSQL\\
Servername=$PGSQL_HOST\\
Port=$PGSQL_PORT\\
Database=$PGSQL_NAME\\
Username=$PGSQL_USER\\
Password=$PGSQL_PASSWORD\\
ReadOnly=No\\
Protocol=7.4-1"
  elif [ "$MARIADB_ENABLED" = "y" ]; then
    GENERIC_DSN_CONFIG="Driver=MariaDB\\
Server=$MARIADB_HOST\\
Port=$MARIADB_PORT\\
Database=$MARIADB_NAME\\
User=$MARIADB_USER\\
Password=$MARIADB_PASSWORD\\
Option=3"
  else
    # Default to SQLite3
    GENERIC_DSN_CONFIG="Driver=SQLite3\\
Database=$SQLITE3_PATH\\
Timeout=5000"
  fi

  # Replace placeholders (except GENERIC_DSN_CONFIG)
  ODBC_CONTENT=$(echo "$ODBC_CONTENT" | sed "s|{{PROJECT_NAME}}|$PROJECT_NAME|g")
  ODBC_CONTENT=$(echo "$ODBC_CONTENT" | sed "s|{{SQLITE3_CONNECTION}}|$SQLITE3_PATH|g")
  ODBC_CONTENT=$(echo "$ODBC_CONTENT" | sed "s|{{MARIADB_HOST}}|$MARIADB_HOST|g")
  ODBC_CONTENT=$(echo "$ODBC_CONTENT" | sed "s|{{MARIADB_PORT}}|$MARIADB_PORT|g")
  ODBC_CONTENT=$(echo "$ODBC_CONTENT" | sed "s|{{MARIADB_NAME}}|$MARIADB_NAME|g")
  ODBC_CONTENT=$(echo "$ODBC_CONTENT" | sed "s|{{MARIADB_USER}}|$MARIADB_USER|g")
  ODBC_CONTENT=$(echo "$ODBC_CONTENT" | sed "s|{{MARIADB_PASSWORD}}|$MARIADB_PASSWORD|g")
  ODBC_CONTENT=$(echo "$ODBC_CONTENT" | sed "s|{{PGSQL_HOST}}|$PGSQL_HOST|g")
  ODBC_CONTENT=$(echo "$ODBC_CONTENT" | sed "s|{{PGSQL_PORT}}|$PGSQL_PORT|g")
  ODBC_CONTENT=$(echo "$ODBC_CONTENT" | sed "s|{{PGSQL_NAME}}|$PGSQL_NAME|g")
  ODBC_CONTENT=$(echo "$ODBC_CONTENT" | sed "s|{{PGSQL_USER}}|$PGSQL_USER|g")
  ODBC_CONTENT=$(echo "$ODBC_CONTENT" | sed "s|{{PGSQL_PASSWORD}}|$PGSQL_PASSWORD|g")

  # Replace generic DSN config placeholder with actual config (preserving newlines)
  ODBC_CONTENT=$(echo "$ODBC_CONTENT" | sed "s|{{GENERIC_DSN_CONFIG}}|__GENERIC_DSN_PLACEHOLDER__|g")

  # Write to /etc/odbc.ini
  echo "$ODBC_CONTENT" | while IFS= read -r line; do
    if echo "$line" | grep -q "__GENERIC_DSN_PLACEHOLDER__"; then
      printf "%s\n" "$GENERIC_DSN_CONFIG" | sed 's/\\$//'
    else
      echo "$line"
    fi
  done > /etc/odbc.ini || error "Failed to write /etc/odbc.ini (permission denied?)"

  info "ODBC configuration written to /etc/odbc.ini"

  # Create symbolic link to odbc.ini in workspace config directory
  mkdir -p /workspace/conf
  ln -sf /etc/odbc.ini /workspace/conf/odbc.ini
  info "ODBC configuration accessible at /workspace/conf/odbc.ini"

  info "Available DSNs:"
  info "  - ${PROJECT_NAME}          (Default - points to enabled database)"
  info "  - ${PROJECT_NAME}_sqlite   (SQLite3)"
  info "  - ${PROJECT_NAME}_mariadb  (MariaDB)"
  info "  - ${PROJECT_NAME}_postgres (PostgreSQL)"
}

wa_status() {
  # Load environment variables
  [ -f /workspace/.env ] && . /workspace/.env
  [ -f .env ] && . ./.env

  echo ""
  echo "═══════════════════════════════════════════════════════════════════════════"
  echo "                         WEBAPP SERVICES STATUS"
  echo "═══════════════════════════════════════════════════════════════════════════"
  echo ""

  # Helper function to check if a process is running
  check_process() {
    local pid_file="$1"
    local process_pattern="$2"

    # Check PID file first
    if [ -f "$pid_file" ]; then
      PID=$(cat "$pid_file")
      if ps -p $PID > /dev/null 2>&1; then
        echo "running"
        return 0
      fi
    fi

    # Fallback to process pattern
    if [ -n "$process_pattern" ]; then
      if pgrep -f "$process_pattern" > /dev/null 2>&1; then
        echo "running"
        return 0
      fi
    fi

    echo "stopped"
    return 0  # Always return 0 to avoid exiting with set -e
  }

  # Nginx (reverse proxy)
  NGINX_STATUS=$(pgrep -x nginx > /dev/null 2>&1 && echo "running" || echo "stopped")
  NGINX_ICON=$([ "$NGINX_STATUS" = "running" ] && echo "✓" || echo "✗")

  printf "%-25s %-10s %-25s %-20s\n" "SERVICE" "STATUS" "INTERNAL" "EXTERNAL (HOST)"
  echo "───────────────────────────────────────────────────────────────────────────"

  printf "%-25s %-10s %-25s %-20s\n" "nginx (Reverse Proxy)" "[$NGINX_ICON] $NGINX_STATUS" "0.0.0.0:2310" "localhost:2310"

  # API Gateway (FastAPI/uvicorn)
  if /command/s6-svstat /run/service/uvicorn 2>/dev/null | grep -q "^up"; then
    UVICORN_STATUS="running"
  else
    UVICORN_STATUS="stopped"
  fi
  UVICORN_ICON=$([ "$UVICORN_STATUS" = "running" ] && echo "✓" || echo "✗")
  API_HOST=${API_HOST:-127.0.0.1}
  API_PORT=${API_PORT:-2310}

  printf "%-25s %-10s %-25s %-20s\n" "API Gateway (FastAPI)" "[$UVICORN_ICON] $UVICORN_STATUS" "127.0.0.1:8000" "localhost:$API_PORT (via nginx)"

  # GUI Dev Server (Vite)
  FE_STATUS=$(check_process "/tmp/gui-dev.pid" "node.*vite")
  FE_ICON=$([ "$FE_STATUS" = "running" ] && echo "✓" || echo "✗")
  VITE_PORT=${VITE_PORT:-5173}

  printf "%-25s %-10s %-25s %-20s\n" "GUI Dev (Vite)" "[$FE_ICON] $FE_STATUS" "0.0.0.0:$VITE_PORT" "localhost:$VITE_PORT"

  # Database
  if [ "$SQLITE3_ENABLED" = "y" ]; then
    SQLITE3_DB_PATH=$(echo "${SQLITE3_CONNECTION:-file:/workspace/data/microcrm.db}" | sed 's/file://')
    if [ -f "$SQLITE3_DB_PATH" ]; then
      DB_STATUS="running"
      DB_ICON="✓"
    else
      DB_STATUS="not found"
      DB_ICON="✗"
    fi
    printf "%-25s %-10s %-25s %-20s\n" "Database (SQLite3)" "[$DB_ICON] $DB_STATUS" "$SQLITE3_DB_PATH" "N/A"
  elif [ "$PGSQL_ENABLED" = "y" ]; then
    PGSQL_PORT=$(echo "$PGSQL_CONNECTION" | grep -oP 'port=\K[^,\s]+' | head -1)
    PGSQL_HOST=$(echo "$PGSQL_CONNECTION" | grep -oP 'host=\K[^,\s]+' | head -1)
    printf "%-25s %-10s %-25s %-20s\n" "Database (PostgreSQL)" "[?] external" "$PGSQL_HOST:$PGSQL_PORT" "localhost:${PGSQL_PORT:-2340}"
  elif [ "$MARIADB_ENABLED" = "y" ]; then
    MARIADB_PORT=$(echo "$MARIADB_CONNECTION" | grep -oP 'port=\K[^,]+' | head -1)
    MARIADB_HOST=$(echo "$MARIADB_CONNECTION" | grep -oP 'host=\K[^,]+' | head -1)
    printf "%-25s %-10s %-25s %-20s\n" "Database (MariaDB)" "[?] external" "$MARIADB_HOST:$MARIADB_PORT" "localhost:${MARIADB_PORT:-2330}"
  fi

  # Redis
  REDIS_STATUS=$(redis-cli ping 2>/dev/null | grep -q PONG && echo "running" || echo "stopped")
  REDIS_ICON=$([ "$REDIS_STATUS" = "running" ] && echo "✓" || echo "✗")

  printf "%-25s %-10s %-25s %-20s\n" "Redis (Cache/Session)" "[$REDIS_ICON] $REDIS_STATUS" "127.0.0.1:6379" "N/A"

  # Find all microservices in /workspace/services/
  if [ -d /workspace/services ]; then
    for service_dir in /workspace/services/mod_*/; do
      if [ -d "$service_dir" ]; then
        SERVICE_NAME=$(basename "$service_dir")
        SERVICE_VAR=$(echo "$SERVICE_NAME" | tr '[:lower:]' '[:upper:]' | tr '-' '_')
        BINARY_NAME=$(echo "$SERVICE_NAME" | sed 's/^mod_//')

        # Get port from environment variable (e.g., MICROSERVICE_MOD_STATUS_PORT or MOD_STATUS_PORT)
        eval "SERVICE_PORT=\${MICROSERVICE_${SERVICE_VAR}_PORT:-\${${SERVICE_VAR}_PORT}}"
        eval "SERVICE_HOST=\${MICROSERVICE_${SERVICE_VAR}_HOST:-\${${SERVICE_VAR}_HOST:-127.0.0.1}}"

        # Check if service is running (binary name without mod_ prefix)
        MS_STATUS=$(check_process "/tmp/$SERVICE_NAME.pid" "$SERVICE_DIR/bin/$BINARY_NAME")
        MS_ICON=$([ "$MS_STATUS" = "running" ] && echo "✓" || echo "✗")

        if [ -n "$SERVICE_PORT" ]; then
          printf "%-25s %-10s %-25s %-20s\n" "$SERVICE_NAME" "[$MS_ICON] $MS_STATUS" "$SERVICE_HOST:$SERVICE_PORT" "N/A (internal only)"
        else
          printf "%-25s %-10s %-25s %-20s\n" "$SERVICE_NAME" "[$MS_ICON] $MS_STATUS" "N/A (no port configured)" "N/A"
        fi
      fi
    done
  fi

  echo "═══════════════════════════════════════════════════════════════════════════"
  echo ""
  echo "Legend: ✓ = running, ✗ = stopped, ? = external/unknown"
  echo ""
  echo "Quick Test URLs:"
  echo "  - API Gateway:  http://localhost:$API_PORT/api/status/health"
  echo "  - API Docs:     http://localhost:$API_PORT/docs"
  if [ "$FE_STATUS" = "running" ]; then
    echo "  - GUI Dev: http://localhost:$VITE_PORT/"
  fi
  if [ "$MS_STATUS" = "running" ] && [ -n "$SERVICE_PORT" ]; then
    echo "  - mod_status:   http://localhost:$SERVICE_PORT/health"
  fi
  echo ""
}

wa_monitor() {
  # Load environment variables
  [ -f /workspace/.env ] && . /workspace/.env
  [ -f .env ] && . ./.env

  echo ""
  echo "═══════════════════════════════════════════════════════════════════════════"
  echo "                    WEBAPP SERVICES - DETAILED MONITORING"
  echo "═══════════════════════════════════════════════════════════════════════════"
  echo ""

  echo "LISTENING PORTS & PROCESSES:"
  echo "───────────────────────────────────────────────────────────────────────────"
  printf "%-15s %-20s %-25s %-10s\n" "PORT" "PROCESS" "COMMAND" "PID"

  # Get listening ports for webapp services
  ss -tlnp 2>/dev/null | grep -E "nginx|uvicorn|mod_status|redis|vite|node.*5173" | while read line; do
    PORT=$(echo "$line" | awk '{print $4}' | rev | cut -d: -f1 | rev)
    PROCESS=$(echo "$line" | grep -oP 'users:\(\("\K[^"]+' || echo "unknown")
    PID=$(echo "$line" | grep -oP 'pid=\K[0-9]+' || echo "?")
    CMD=$(ps -p "$PID" -o comm= 2>/dev/null || echo "?")
    printf "%-15s %-20s %-25s %-10s\n" "$PORT" "$PROCESS" "$CMD" "$PID"
  done

  echo ""
  echo "RESOURCE USAGE (Active Processes):"
  echo "───────────────────────────────────────────────────────────────────────────"
  printf "%-25s %6s %6s %8s %s\n" "PROCESS" "CPU%" "MEM%" "PID" "COMMAND"

  # Show only running processes (not defunct)
  ps aux | grep -E "nginx: master|python.*uvicorn|mod_status|redis-server|node.*vite" | grep -v grep | grep -v defunct | \
    awk '{printf "%-25s %6s %6s %8s %s\n", substr($11,1,25), $3, $4, $2, substr($0, index($0,$11))}'

  echo ""
  echo "SYSTEM RESOURCES:"
  echo "───────────────────────────────────────────────────────────────────────────"

  # CPU info
  CPU_COUNT=$(nproc)
  LOAD=$(uptime | awk -F'load average:' '{print $2}')
  echo "CPU Cores: $CPU_COUNT | Load Average:$LOAD"

  # Memory info
  free -h | grep -E "Mem:|Swap:"

  echo ""
  echo "DISK USAGE (workspace):"
  echo "───────────────────────────────────────────────────────────────────────────"
  df -h /workspace | tail -1 | awk '{printf "Total: %s | Used: %s | Available: %s | Use%%: %s\n", $2, $3, $4, $5}'

  # Database size if SQLite
  if [ "$SQLITE3_ENABLED" = "y" ]; then
    SQLITE3_DB_PATH=$(echo "${SQLITE3_CONNECTION:-file:/workspace/data/microcrm.db}" | sed 's/file://')
    if [ -f "$SQLITE3_DB_PATH" ]; then
      DB_SIZE=$(du -h "$SQLITE3_DB_PATH" | cut -f1)
      echo "Database: $SQLITE3_DB_PATH ($DB_SIZE)"
    fi
  fi

  echo ""
  echo "NETWORK CONNECTIONS:"
  echo "───────────────────────────────────────────────────────────────────────────"
  printf "%-15s %-25s %-25s %-10s\n" "PROTO" "LOCAL ADDRESS" "STATE" "PROCESS"
  ss -tnp 2>/dev/null | grep -E "nginx|uvicorn|mod_status|vite" | head -10 | \
    awk '{printf "%-15s %-25s %-25s %s\n", $1, $4, $5, $6}'

  echo "═══════════════════════════════════════════════════════════════════════════"
  echo ""
  echo "Press 'cmd htop' for interactive monitoring"
  echo ""
}

wa_htop() {
  # Check if htop is installed
  if ! command -v htop >/dev/null 2>&1; then
    error "htop not installed. Install with: apt-get install htop"
  fi

  # Get PIDs of webapp processes
  PIDS=$(ps aux | grep -E "nginx: master|python.*uvicorn|mod_status|redis-server|node.*vite" | grep -v grep | awk '{print $2}' | tr '\n' ',' | sed 's/,$//')

  if [ -z "$PIDS" ]; then
    warn "No webapp processes running. Starting htop anyway..."
    exec htop
  else
    info "Launching htop filtered for webapp processes..."
    info "Inside htop: F5=tree view, F6=sort, F9=kill, F10/q=quit"
    sleep 2
    exec htop -p "$PIDS"
  fi
}

# Check if running inside container
[ -f /.dockerenv ] || [ -n "$CONTAINER" ] || error "Must run inside container"

# Parse command
[ $# -eq 0 ] && show_help

COMMAND="$1"
shift

case "$COMMAND" in
  --help|-h)
    show_help
    ;;

  status)
    wa_status
    ;;

  monitor)
    wa_monitor
    ;;

  htop)
    wa_htop
    ;;

  db)
    # Parse db subcommand
    if [ $# -eq 0 ]; then
      # No options - open interactive CLI
      db_cli ""
      exit 0
    fi

    # Check for action
    DB_ACTION="$1"
    shift

    case "$DB_ACTION" in
      conf)
        # Configure ODBC
        db_configure_odbc
        ;;
      -f)
        # Execute SQL file
        [ -z "$1" ] && error "Option -f requires a file path"
        db_cli "$1"
        ;;
      *)
        error "Unknown db action: $DB_ACTION. Valid actions: conf, -f. Use 'cmd --help' for usage"
        ;;
    esac
    ;;

  service|ms)
    # Parse microservice subcommand
    [ $# -eq 0 ] && error "Microservice action required. Use 'cmd --help' for usage information"

    MS_ACTION="$1"
    shift

    MS_NAME=""

    # Parse options
    while [ $# -gt 0 ]; do
      case $1 in
        -n)
          shift
          [ -z "$1" ] && error "Option -n requires a microservice name"
          MS_NAME="$1"
          shift
          ;;
        *)
          error "Unknown option for 'ms $MS_ACTION': $1. Use 'cmd --help' for usage information"
          ;;
      esac
    done

    # Execute microservice action
    case "$MS_ACTION" in
      build)
        service_build "$MS_NAME"
        ;;
      enable)
        service_enable "$MS_NAME"
        ;;
      disable)
        service_disable "$MS_NAME"
        ;;
      start)
        service_start "$MS_NAME"
        ;;
      stop)
        service_stop "$MS_NAME"
        ;;
      restart)
        service_restart "$MS_NAME"
        ;;
      status)
        service_status "$MS_NAME"
        ;;
      *)
        error "Unknown microservice action: $MS_ACTION. Valid actions: build, enable, disable, start, stop, restart, status"
        ;;
    esac
    ;;

  vite)
    # Parse Vite subcommand
    [ $# -eq 0 ] && error "Vite action required. Use 'cmd --help' for usage information"

    VITE_ACTION="$1"
    shift

    # Execute Vite action
    case "$VITE_ACTION" in
      build)
        vite_build
        ;;
      start)
        vite_start
        ;;
      stop)
        vite_stop
        ;;
      restart)
        vite_restart
        ;;
      status)
        vite_status
        ;;
      *)
        error "Unknown Vite action: $VITE_ACTION. Valid actions: build, start, stop, restart, status"
        ;;
    esac
    ;;

  redis)
    # Parse Redis subcommand
    [ $# -eq 0 ] && error "Redis action required. Use 'cmd --help' for usage information"

    REDIS_ACTION="$1"
    shift

    # Execute Redis action
    case "$REDIS_ACTION" in
      start)
        redis_start
        ;;
      stop)
        redis_stop
        ;;
      restart)
        redis_restart
        ;;
      status)
        redis_status
        ;;
      info)
        redis_info
        ;;
      cli)
        exec redis-cli "$@"
        ;;
      *)
        error "Unknown Redis action: $REDIS_ACTION. Valid actions: start, stop, restart, status, info, cli"
        ;;
    esac
    ;;

  gunicorn)
    # Parse Gunicorn subcommand
    [ $# -eq 0 ] && error "Gunicorn action required. Use 'cmd --help' for usage information"

    GUNICORN_ACTION="$1"
    shift

    # Execute Gunicorn action
    case "$GUNICORN_ACTION" in
      start)
        gunicorn_start
        ;;
      stop)
        gunicorn_stop
        ;;
      restart)
        gunicorn_restart
        ;;
      status)
        gunicorn_status
        ;;
      *)
        error "Unknown Gunicorn action: $GUNICORN_ACTION. Valid actions: start, stop, restart, status"
        ;;
    esac

    ;;
  uvicorn)
    # Parse Uvicorn subcommand
    [ $# -eq 0 ] && error "Uvicorn action required. Use 'cmd --help' for usage information"

    UVICORN_ACTION="$1"
    shift

    # Execute Uvicorn action
    case "$UVICORN_ACTION" in
      start)
        uvicorn_start
        ;;
      stop)
        uvicorn_stop
        ;;
      restart)
        uvicorn_restart
        ;;
      status)
        uvicorn_status
        ;;
      *)
        error "Unknown Uvicorn action: $UVICORN_ACTION. Valid actions: start, stop, restart, status"
        ;;
    esac
    ;;

  nginx)
    # Parse Nginx subcommand
    [ $# -eq 0 ] && error "Nginx action required. Use 'cmd --help' for usage information"

    NGINX_ACTION="$1"
    shift

    # Execute Nginx action
    case "$NGINX_ACTION" in
      start)
        nginx_start
        ;;
      stop)
        nginx_stop
        ;;
      restart)
        nginx_restart
        ;;
      status)
        nginx_status
        ;;
      *)
        error "Unknown Nginx action: $NGINX_ACTION. Valid actions: start, stop, restart, status"
        ;;
    esac
    ;;

  list)
    service_list
    ;;

  module)
    # Parse module subcommand
    [ $# -eq 0 ] && error "Module action required. Use 'cmd --help' for usage information"

    MODULE_ACTION="$1"
    shift

    # Execute module action
    case "$MODULE_ACTION" in
      export)
        # Parse export options
        MODULE_NAME=""
        while [ $# -gt 0 ]; do
          case $1 in
            -n)
              shift
              [ -z "$1" ] && error "Option -n requires a module name"
              MODULE_NAME="$1"
              shift
              ;;
            *)
              error "Unknown option for 'module export': $1. Use: cmd module export -n <module-name>"
              ;;
          esac
        done
        module_export "$MODULE_NAME"
        ;;
      import)
        # Parse import options
        IMPORT_NAME=""
        IMPORT_FORCE=""
        while [ $# -gt 0 ]; do
          case $1 in
            -n)
              shift
              [ -z "$1" ] && error "Option -n requires an archive name"
              IMPORT_NAME="$1"
              shift
              ;;
            --force)
              IMPORT_FORCE="--force"
              shift
              ;;
            *)
              error "Unknown option for 'module import': $1. Use: cmd module import -n <archive-name> [--force]"
              ;;
          esac
        done
        module_import "$IMPORT_NAME" "$IMPORT_FORCE"
        ;;
      *)
        error "Unknown module action: $MODULE_ACTION. Valid actions: export, import"
        ;;
    esac
    ;;

  git)
    # Parse git subcommand
    [ $# -eq 0 ] && error "Git action required. Use 'cmd --help' for usage information"

    GIT_ACTION="$1"
    shift

    # Execute git action
    case "$GIT_ACTION" in
      push)
        git_push
        ;;
      pull)
        git_pull
        ;;
      sync)
        git_sync
        ;;
      branch)
        # Parse branch options
        BRANCH_NAME=""
        REPO_NAME=""
        while [ $# -gt 0 ]; do
          case $1 in
            -b)
              shift
              [ -z "$1" ] && error "Option -b requires a branch name"
              BRANCH_NAME="$1"
              shift
              ;;
            *)
              # First unknown argument is the repo name
              if [ -z "$REPO_NAME" ]; then
                REPO_NAME="$1"
                shift
              else
                error "Unknown option for 'git branch': $1. Use: cmd git branch -b <branch-name> [<repo-name>]"
              fi
              ;;
          esac
        done
        git_branch "$BRANCH_NAME" "$REPO_NAME"
        ;;
      merge)
        # Parse merge options
        MERGE_BRANCH=""
        MERGE_REPO=""
        while [ $# -gt 0 ]; do
          case $1 in
            -b)
              shift
              [ -z "$1" ] && error "Option -b requires a branch name"
              MERGE_BRANCH="$1"
              shift
              ;;
            *)
              # First unknown argument is the repo name
              if [ -z "$MERGE_REPO" ]; then
                MERGE_REPO="$1"
                shift
              else
                error "Unknown option for 'git merge': $1. Use: cmd git merge -b <branch-name> [<repo-name>]"
              fi
              ;;
          esac
        done
        git_merge "$MERGE_BRANCH" "$MERGE_REPO"
        ;;
      *)
        error "Unknown git action: $GIT_ACTION. Valid actions: push, pull, sync, branch, merge"
        ;;
    esac
    ;;

  lib)
    # Parse lib subcommand
    [ $# -eq 0 ] && error "Lib action required. Use 'cmd --help' for usage information"

    LIB_ACTION="$1"
    shift

    case "$LIB_ACTION" in
      build)
        lib_build
        ;;
      *)
        error "Unknown lib action: $LIB_ACTION. Valid actions: build"
        ;;
    esac
    ;;

  *)
    error "Unknown command: $COMMAND. Use 'cmd --help' for usage information"
    ;;
esac
