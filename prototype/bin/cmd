#!/bin/sh
set -e

# WebApp utility script
# Must be run inside container only

DB_CLI_FILE=""

error() { printf 'ERROR: %s\n' "$1" >&2; exit 1; }
info() { printf 'INFO: %s\n' "$1"; }
warn() { printf 'WARNING: %s\n' "$1" >&2; }
success() { printf '✓ SUCCESS: %s
' "$1"; }
success() { printf '✓ SUCCESS: %s
' "$1"; }

# Ask for user confirmation
confirm() {
  printf '%s [y/N]: ' "$1"
  read -r answer
  case "$answer" in
    [Yy]|[Yy][Ee][Ss]) return 0 ;;
    *) return 1 ;;
  esac
}

# Load and export all environment variables from .env
load_env() {
  if [ -f /workspace/.env ]; then
    set -a  # Export all variables
    . /workspace/.env
    set +a  # Stop exporting
  fi
  if [ -f .env ]; then
    set -a
    . ./.env
    set +a
  fi
}

show_help() {
  cat << 'EOF'
Usage: cmd COMMAND [OPTIONS]

Commands:
  cmd status                    Show all services status
  cmd monitor                   Show detailed monitoring (ports, CPU, memory)
  cmd list                      List all s6 services and their status
  cmd db                        Open database CLI
  cmd db -f FILE                Execute SQL/CSV file
  cmd db conf                   Configure ODBC from .env settings

Microservice Management (C++ services):
  cmd service build -n NAME     Build C++ microservice (does not enable)
  cmd service enable -n NAME    Enable and start microservice (runtime + persistent)
  cmd service disable -n NAME   Stop and disable microservice
  cmd service start -n NAME     Start enabled microservice
  cmd service stop -n NAME      Stop enabled microservice
  cmd service restart -n NAME   Restart enabled microservice
  cmd service status -n NAME    Show microservice status

Library Management:
  cmd lib build                 Build and install libmicrotools.a static library

Service Management:
  cmd redis start|stop|restart|status|info|cli
  cmd uvicorn start|stop|restart|status
  cmd nginx start|stop|restart|status
  cmd gunicorn start|stop|restart|status
  cmd vite build|start|stop|restart|status
  
Git Operations:
  cmd git push                      Push changes to git repositories (workspace and project)
  cmd git pull                      Pull changes from git repositories (workspace and project)
  cmd git sync                      Sync git repositories (pull, commit, push)
  cmd git branch -b <name> [<repo>] Create/switch to branch and push to remote if needed  
  cmd git merge -b <name> [<repo>]  Merge branch into main and delete from local/remote
                                   

Module Management:
  cmd module export -n <name>       Export module to tar.gz archive in dist/modules/
  cmd module import -n <name> [--force]
                                   Import module from tar.gz archive
                                   Use --force to overwrite existing module

Other:
  cmd --help, -h                Show this help

Services managed by s6-overlay:
  - nginx, redis, uvicorn, mod_status (enabled by default)
  - gunicorn, vite (disabled by default)

Note: Core services (nginx, redis, uvicorn) and microservices use s6-overlay.
      Vite dev server is managed independently via 'cmd vite' commands.
      Use 'cmd list' to see all s6-managed services.

EOF
  exit 0
}

resolve_file_dependencies() {
  SQL_FILE="$1"
  SQL_DIR="$(dirname "$SQL_FILE")"

  [ ! -f "$SQL_FILE" ] && error "File not found: $SQL_FILE"

  # Temporary files to track execution order and visited files
  TMP_SORTED=$(mktemp)
  TMP_VISITED=$(mktemp)

  # Recursive function to trace dependencies
  trace_dependencies() {
    local file_path="$1"
    local filename=$(basename "$file_path")
    # Calculate relative path from SQL_DIR
    local rel_path="${file_path#$SQL_DIR/}"

    # Check if already visited (prevent infinite loops)
    if grep -q "^$(echo "$rel_path" | sed 's/[^^]/[&]/g; s/\^/\\^/g')$" "$TMP_VISITED"; then
      return 0
    fi

    # Mark as visited
    echo "$rel_path" >> "$TMP_VISITED"

    # Extract and process @require directives
    if grep -q "^--[[:space:]]*@require" "$file_path"; then
      grep "^--[[:space:]]*@require" "$file_path" | while read -r line; do
        # Extract required filename
        required=$(echo "$line" | sed 's/^--[[:space:]]*@require[[:space:]]*//; s/[[:space:]]*$//')
        required_path="$SQL_DIR/$required"

        # Check if required file exists
        if [ ! -f "$required_path" ]; then
          warn "Dependency not found: $required (required by $filename)"
          continue
        fi

        # Recursively trace dependencies of required file
        trace_dependencies "$required_path"
      done
    fi

    # Add current file to execution list (after its dependencies)
    echo "$rel_path" >> "$TMP_SORTED"
  }

  # Start tracing from the requested file
  trace_dependencies "$SQL_FILE"

  # Output sorted list (dependencies first, then the file itself)
  cat "$TMP_SORTED"

  # Cleanup
  rm -f "$TMP_SORTED" "$TMP_VISITED"
}

db_cli() {
  load_env

  FILE="$1"

  # If file is provided
  if [ -n "$FILE" ]; then
    # Directories are not supported - must specify a single SQL file
    if [ -d "$FILE" ]; then
      error "Directory execution not supported. Please specify a single .sql file (dependencies will be resolved automatically)"
    fi

    [ ! -f "$FILE" ] && error "File not found: $FILE"

    FILE_EXT=$(echo "$FILE" | grep -o '\.[^.]*$')

    # Handle CSV files
    if [ "$FILE_EXT" = ".csv" ]; then
      TABLE_NAME=$(basename "$FILE" .csv)
      COLUMNS=$(head -1 "$FILE" | sed 's/"//g' | sed 's/;/,/g')

      if [ "$PGSQL_ENABLED" = "y" ]; then
        info "Loading CSV into PostgreSQL table: $TABLE_NAME"
        export PGPASSWORD="$PGSQL_PASSWORD"
        # Extract host from connection string
        PGSQL_HOST=$(echo "$PGSQL_CONNECTION" | grep -oP 'host=\K[^,\s]+' | head -1)
        PGSQL_PORT=$(echo "$PGSQL_CONNECTION" | grep -oP 'port=\K[^,\s]+' | head -1)
        PGSQL_USER=$(echo "$PGSQL_CONNECTION" | grep -oP 'user=\K[^,\s]+' | head -1)
        PGSQL_DBNAME=$(echo "$PGSQL_CONNECTION" | grep -oP 'dbname=\K[^,\s]+' | head -1)

        psql -h "${PGSQL_HOST:-localhost}" -p "${PGSQL_PORT:-5432}" -U "${PGSQL_USER:-postgres}" -d "${PGSQL_DBNAME}" \
          -c "\\COPY $TABLE_NAME ($COLUMNS) FROM '$FILE' WITH (FORMAT CSV, HEADER true, DELIMITER ';', QUOTE '\"', NULL '\\N')"

      elif [ "$MARIADB_ENABLED" = "y" ]; then
        info "Loading CSV into MariaDB table: $TABLE_NAME"
        # Extract connection params
        MARIADB_HOST=$(echo "$MARIADB_CONNECTION" | grep -oP 'host=\K[^,]+' | head -1)
        MARIADB_PORT=$(echo "$MARIADB_CONNECTION" | grep -oP 'port=\K[^,]+' | head -1)
        MARIADB_USER=$(echo "$MARIADB_CONNECTION" | grep -oP 'user=\K[^,]+' | head -1)
        MARIADB_PASS=$(echo "$MARIADB_CONNECTION" | grep -oP 'pass=\K[^,]+' | head -1)
        MARIADB_DBNAME=$(echo "$MARIADB_CONNECTION" | grep -oP 'dbname=\K[^,]+' | head -1)

        mysql -h "${MARIADB_HOST:-localhost}" -P "${MARIADB_PORT:-3306}" -u "${MARIADB_USER}" -p"${MARIADB_PASS}" "${MARIADB_DBNAME}" \
          -e "LOAD DATA LOCAL INFILE '$FILE' INTO TABLE $TABLE_NAME FIELDS TERMINATED BY ';' ENCLOSED BY '\"' LINES TERMINATED BY '\\n' IGNORE 1 LINES;"

      elif [ "$SQLITE3_ENABLED" = "y" ]; then
        SQLITE3_DB_PATH=$(echo "$SQLITE3_CONNECTION" | sed 's/file://')
        info "Loading CSV into SQLite table: $TABLE_NAME at $SQLITE3_DB_PATH"
        sqlite3 "$SQLITE3_DB_PATH" <<SQLITECMD
.mode csv
.separator ";"
.import --skip 1 $FILE $TABLE_NAME
SQLITECMD
      else
        error "No database enabled. Set SQLITE3_ENABLED, MARIADB_ENABLED, or PGSQL_ENABLED to 'y'"
      fi
      info "CSV file loaded successfully"

    # Handle SQL files
    elif [ "$FILE_EXT" = ".sql" ]; then
      # Resolve dependencies and get execution order
      info "Resolving dependencies for: $(basename "$FILE")"
      SORTED_FILES=$(resolve_file_dependencies "$FILE")
      SQL_DIR=$(dirname "$FILE")

      if [ -z "$SORTED_FILES" ]; then
        warn "No files to execute"
        return 1
      fi

      # Execute each file in dependency order
      echo "$SORTED_FILES" | while read -r sql_filename; do
        sql_filepath="$SQL_DIR/$sql_filename"
        [ ! -f "$sql_filepath" ] && continue

        info "  Executing: $sql_filename"

        if [ "$PGSQL_ENABLED" = "y" ]; then
          export PGPASSWORD="$PGSQL_PASSWORD"
          # Extract connection params
          PGSQL_HOST=$(echo "$PGSQL_CONNECTION" | grep -oP 'host=\K[^,\s]+' | head -1)
          PGSQL_PORT=$(echo "$PGSQL_CONNECTION" | grep -oP 'port=\K[^,\s]+' | head -1)
          PGSQL_USER=$(echo "$PGSQL_CONNECTION" | grep -oP 'user=\K[^,\s]+' | head -1)
          PGSQL_DBNAME=$(echo "$PGSQL_CONNECTION" | grep -oP 'dbname=\K[^,\s]+' | head -1)

          psql -h "${PGSQL_HOST:-localhost}" -p "${PGSQL_PORT:-5432}" -U "${PGSQL_USER:-postgres}" -d "${PGSQL_DBNAME}" -f "$sql_filepath" || warn "Failed to execute $sql_filename"

        elif [ "$MARIADB_ENABLED" = "y" ]; then
          # Extract connection params
          MARIADB_HOST=$(echo "$MARIADB_CONNECTION" | grep -oP 'host=\K[^,]+' | head -1)
          MARIADB_PORT=$(echo "$MARIADB_CONNECTION" | grep -oP 'port=\K[^,]+' | head -1)
          MARIADB_USER=$(echo "$MARIADB_CONNECTION" | grep -oP 'user=\K[^,]+' | head -1)
          MARIADB_PASS=$(echo "$MARIADB_CONNECTION" | grep -oP 'pass=\K[^,]+' | head -1)
          MARIADB_DBNAME=$(echo "$MARIADB_CONNECTION" | grep -oP 'dbname=\K[^,]+' | head -1)

          mysql -h "${MARIADB_HOST:-localhost}" -P "${MARIADB_PORT:-3306}" -u "${MARIADB_USER}" -p"${MARIADB_PASS}" "${MARIADB_DBNAME}" < "$sql_filepath" || warn "Failed to execute $sql_filename"

        elif [ "$SQLITE3_ENABLED" = "y" ]; then
          SQLITE3_DB_PATH=$(echo "$SQLITE3_CONNECTION" | sed 's/file://')
          sqlite3 "$SQLITE3_DB_PATH" < "$sql_filepath" || warn "Failed to execute $sql_filename"
        else
          error "No database enabled. Set SQLITE3_ENABLED, MARIADB_ENABLED, or PGSQL_ENABLED to 'y'"
        fi
      done

      info "SQL file executed successfully (with dependencies)"
    else
      error "Unsupported file type. Use .sql or .csv"
    fi

  # No file - open interactive CLI
  else
    if [ "$PGSQL_ENABLED" = "y" ]; then
      info "Connecting to PostgreSQL database..."
      export PGPASSWORD="$PGSQL_PASSWORD"
      # Extract connection params
      PGSQL_HOST=$(echo "$PGSQL_CONNECTION" | grep -oP 'host=\K[^,\s]+' | head -1)
      PGSQL_PORT=$(echo "$PGSQL_CONNECTION" | grep -oP 'port=\K[^,\s]+' | head -1)
      PGSQL_USER=$(echo "$PGSQL_CONNECTION" | grep -oP 'user=\K[^,\s]+' | head -1)
      PGSQL_DBNAME=$(echo "$PGSQL_CONNECTION" | grep -oP 'dbname=\K[^,\s]+' | head -1)

      psql -h "${PGSQL_HOST:-localhost}" -p "${PGSQL_PORT:-5432}" -U "${PGSQL_USER:-postgres}" -d "${PGSQL_DBNAME}"

    elif [ "$MARIADB_ENABLED" = "y" ]; then
      info "Connecting to MariaDB database..."
      # Extract connection params
      MARIADB_HOST=$(echo "$MARIADB_CONNECTION" | grep -oP 'host=\K[^,]+' | head -1)
      MARIADB_PORT=$(echo "$MARIADB_CONNECTION" | grep -oP 'port=\K[^,]+' | head -1)
      MARIADB_USER=$(echo "$MARIADB_CONNECTION" | grep -oP 'user=\K[^,]+' | head -1)
      MARIADB_PASS=$(echo "$MARIADB_CONNECTION" | grep -oP 'pass=\K[^,]+' | head -1)
      MARIADB_DBNAME=$(echo "$MARIADB_CONNECTION" | grep -oP 'dbname=\K[^,]+' | head -1)

      mysql -h "${MARIADB_HOST:-localhost}" -P "${MARIADB_PORT:-3306}" -u "${MARIADB_USER}" -p"${MARIADB_PASS}" "${MARIADB_DBNAME}"

    elif [ "$SQLITE3_ENABLED" = "y" ]; then
      SQLITE3_DB_PATH=$(echo "$SQLITE3_CONNECTION" | sed 's/file://')
      info "Connecting to SQLite database: $SQLITE3_DB_PATH"
      sqlite3 "$SQLITE3_DB_PATH"
    else
      error "No database enabled. Set SQLITE3_ENABLED, MARIADB_ENABLED, or PGSQL_ENABLED to 'y'"
    fi
  fi
}

service_build() {
  SERVICE_NAME="$1"
  SERVICE_DIR="/workspace/services/$SERVICE_NAME"

  [ -z "$SERVICE_NAME" ] && error "Service name is required. Use: wa service build -n <name>"
  [ ! -d "$SERVICE_DIR" ] && error "Service not found: $SERVICE_NAME (directory $SERVICE_DIR does not exist)"

  info "Building $SERVICE_NAME microservice..."

  # Check if CMakeLists.txt exists (C++ microservice)
  if [ ! -f "$SERVICE_DIR/CMakeLists.txt" ]; then
    error "No build configuration found. Expected CMakeLists.txt in $SERVICE_DIR"
  fi

  info "Building C++ microservice with CMake..."
  cd "$SERVICE_DIR"
  mkdir -p build
  cd build
  cmake .. -DCMAKE_BUILD_TYPE=Debug > /workspace/logs/"$SERVICE_NAME"-build.log 2>&1 || error "CMake configuration failed. Check /workspace/logs/$SERVICE_NAME-build.log"
  make -j$(nproc) >> /workspace/logs/"$SERVICE_NAME"-build.log 2>&1 || error "Build failed for $SERVICE_NAME. Check /workspace/logs/$SERVICE_NAME-build.log"
  cd /workspace

  # Check if binary was created
  BINARY_NAME=$(basename "$SERVICE_NAME" | sed 's/^mod_//')
  if [ -f "$SERVICE_DIR/bin/$BINARY_NAME" ]; then
    info "Build complete. Binary: $SERVICE_DIR/bin/$BINARY_NAME"
    info "Binary size: $(du -h "$SERVICE_DIR/bin/$BINARY_NAME" | cut -f1)"
  else
    warn "Build completed but binary not found at expected location: $SERVICE_DIR/bin/$BINARY_NAME"
  fi
}

lib_build() {
  LIB_SRC="/workspace/.toolchain/prototype/lib/utils/cpp"
  LIB_DEST="/workspace/services/utils"
  LIB_LOG="/workspace/logs/libmicrotools-build.log"

  [ ! -d "$LIB_SRC" ] && error "Library sources not found: $LIB_SRC"

  info "Copying microtools library sources to services/utils..."
  mkdir -p "$LIB_DEST"
  rm -rf "$LIB_DEST"/*
  cp -r "$LIB_SRC"/* "$LIB_DEST"/

  info "Compiling microtools static library..."
  cd "$LIB_DEST"
  mkdir -p build
  cd build

  cmake .. > "$LIB_LOG" 2>&1 || error "CMake configuration failed. Check $LIB_LOG"
  make -j$(nproc) >> "$LIB_LOG" 2>&1 || error "Build failed. Check $LIB_LOG"

  if [ -f libmicrotools.a ]; then
    mkdir -p /usr/local/lib
    mkdir -p /usr/local/include/microtools
    cp libmicrotools.a /usr/local/lib/
    cp ../*.h /usr/local/include/microtools/
    info "Library installed: /usr/local/lib/libmicrotools.a"
    info "Headers installed: /usr/local/include/microtools/"
    info "Library size: $(du -h /usr/local/lib/libmicrotools.a | cut -f1)"
  else
    error "Build completed but libmicrotools.a not found"
  fi

  cd /workspace
}

service_enable() {
  SERVICE_NAME="$1"

  [ -z "$SERVICE_NAME" ] && error "Service name is required. Use: wa service enable -n <name>"

  # Check if service definition exists
  if [ ! -d "/etc/services.d.available/$SERVICE_NAME" ]; then
    error "Service '$SERVICE_NAME' not found in /etc/services.d.available/"
  fi

  # Check if already enabled
  if [ -d "/etc/services.d/$SERVICE_NAME" ] && [ -L "/run/service/$SERVICE_NAME" ]; then
    info "Service '$SERVICE_NAME' is already enabled"
    return 0
  fi

  info "Enabling $SERVICE_NAME service..."

  # 1. Copy to /etc/services.d/ for persistence
  if [ ! -d "/etc/services.d/$SERVICE_NAME" ]; then
    cp -r "/etc/services.d.available/$SERVICE_NAME" "/etc/services.d/$SERVICE_NAME"
    info "  Copied to /etc/services.d/ (persistent)"
  fi

  # 2. Copy to runtime directory
  if [ ! -d "/run/s6/legacy-services/$SERVICE_NAME" ]; then
    cp -r "/etc/services.d.available/$SERVICE_NAME" "/run/s6/legacy-services/$SERVICE_NAME"
    info "  Copied to /run/s6/legacy-services/ (runtime)"
  fi

  # 3. Create symlink in /run/service/
  if [ ! -L "/run/service/$SERVICE_NAME" ]; then
    ln -sf "/run/s6/legacy-services/$SERVICE_NAME" "/run/service/$SERVICE_NAME"
    info "  Created symlink in /run/service/"
  fi

  # 4. Notify s6-svscan to rescan
  /command/s6-svscanctl -a /run/service 2>/dev/null || warn "Failed to notify s6-svscan"

  sleep 1

  # 5. Check if service started
  if /command/s6-svstat "/run/service/$SERVICE_NAME" >/dev/null 2>&1; then
    success "Service '$SERVICE_NAME' enabled and started"
  else
    warn "Service enabled but may not have started. Check logs."
  fi
}

service_disable() {
  SERVICE_NAME="$1"

  [ -z "$SERVICE_NAME" ] && error "Service name is required. Use: wa service disable -n <name>"

  # Prevent disabling critical services
  case "$SERVICE_NAME" in
    nginx|redis|uvicorn)
      warn "Cannot disable critical service '$SERVICE_NAME'"
      error "Disabling core services will break the application"
      ;;
  esac

  # Check if service is enabled
  if [ ! -d "/etc/services.d/$SERVICE_NAME" ] && [ ! -L "/run/service/$SERVICE_NAME" ]; then
    info "Service '$SERVICE_NAME' is already disabled"
    return 0
  fi

  info "Disabling $SERVICE_NAME service..."

  # 1. Stop service if running
  if [ -L "/run/service/$SERVICE_NAME" ]; then
    info "  Stopping service..."
    /command/s6-svc -d "/run/service/$SERVICE_NAME" 2>/dev/null || true
    sleep 1
  fi

  # 2. Remove from /run/service/
  if [ -L "/run/service/$SERVICE_NAME" ]; then
    rm -f "/run/service/$SERVICE_NAME"
    info "  Removed from /run/service/"
  fi

  # 3. Remove from runtime directory
  if [ -d "/run/s6/legacy-services/$SERVICE_NAME" ]; then
    rm -rf "/run/s6/legacy-services/$SERVICE_NAME"
    info "  Removed from /run/s6/legacy-services/"
  fi

  # 4. Remove from persistent directory
  if [ -d "/etc/services.d/$SERVICE_NAME" ]; then
    rm -rf "/etc/services.d/$SERVICE_NAME"
    info "  Removed from /etc/services.d/"
  fi

  # 5. Notify s6-svscan to rescan
  /command/s6-svscanctl -n /run/service 2>/dev/null || warn "Failed to notify s6-svscan"

  success "Service '$SERVICE_NAME' disabled"
}

service_start() {
  SERVICE_NAME="$1"

  [ -z "$SERVICE_NAME" ] && error "Service name is required. Use: wa service start -n <name>"

  # Check if service is enabled
  if [ ! -L "/run/service/$SERVICE_NAME" ]; then
    error "Service '$SERVICE_NAME' is not enabled. Enable it first with: wa service enable -n $SERVICE_NAME"
  fi

  info "Starting $SERVICE_NAME service..."
  local cmd_output=$(/command/s6-svc -u "/run/service/$SERVICE_NAME" 2>&1)

  sleep 1

  if /command/s6-svstat "/run/service/$SERVICE_NAME" | grep -q "^up"; then
    success "$SERVICE_NAME started successfully"
  else
    printf 'ERROR: Failed to start %s\n' "$SERVICE_NAME" >&2
    [ -n "$cmd_output" ] && echo "Command output: $cmd_output"

    # Show last log lines if available
    local log_file="/workspace/logs/${SERVICE_NAME}.log"
    if [ -f "$log_file" ]; then
      echo ""
      echo "Last 10 log lines:"
      tail -n 10 "$log_file" | sed 's/^/  /'
    fi
    exit 1
  fi
}

service_stop() {
  SERVICE_NAME="$1"

  [ -z "$SERVICE_NAME" ] && error "Service name is required. Use: wa service stop -n <name>"

  # Check if service is enabled
  if [ ! -L "/run/service/$SERVICE_NAME" ]; then
    error "Service '$SERVICE_NAME' is not enabled"
  fi

  info "Stopping $SERVICE_NAME service..."
  local cmd_output=$(/command/s6-svc -d "/run/service/$SERVICE_NAME" 2>&1)

  sleep 1

  if /command/s6-svstat "/run/service/$SERVICE_NAME" | grep -q "^down"; then
    success "$SERVICE_NAME stopped successfully"
  else
    printf 'ERROR: Failed to stop %s\n' "$SERVICE_NAME" >&2
    [ -n "$cmd_output" ] && echo "Command output: $cmd_output"

    # Show last log lines if available
    local log_file="/workspace/logs/${SERVICE_NAME}.log"
    if [ -f "$log_file" ]; then
      echo ""
      echo "Last 10 log lines:"
      tail -n 10 "$log_file" | sed 's/^/  /'
    fi
    exit 1
  fi
}

service_status() {
  SERVICE_NAME="$1"

  [ -z "$SERVICE_NAME" ] && error "Service name is required. Use: wa service status -n <name>"

  # Check if service is enabled
  if [ ! -L "/run/service/$SERVICE_NAME" ]; then
    error "Service '$SERVICE_NAME' is not enabled"
  fi

  echo ""
  echo "═══════════════════════════════════════════════════════════════════════════"
  echo "                      $(echo $SERVICE_NAME | tr [:lower:] [:upper:]) SERVICE STATUS"
  echo "═══════════════════════════════════════════════════════════════════════════"
  echo ""

  local status_output=$(/command/s6-svstat "/run/service/$SERVICE_NAME")
  echo "  $status_output"
  echo ""
}

service_restart() {
  SERVICE_NAME="$1"

  [ -z "$SERVICE_NAME" ] && error "Service name is required. Use: wa service restart -n <name>"

  # Check if service is enabled
  if [ ! -L "/run/service/$SERVICE_NAME" ]; then
    error "Service '$SERVICE_NAME' is not enabled. Enable it first with: wa service enable -n $SERVICE_NAME"
  fi

  info "Restarting $SERVICE_NAME service..."

  # Stop service
  local stop_output=$(/command/s6-svc -d "/run/service/$SERVICE_NAME" 2>&1)
  sleep 1

  # Start service
  local start_output=$(/command/s6-svc -u "/run/service/$SERVICE_NAME" 2>&1)
  sleep 1

  if /command/s6-svstat "/run/service/$SERVICE_NAME" | grep -q "^up"; then
    success "$SERVICE_NAME restarted successfully"
  else
    printf 'ERROR: Failed to restart %s\n' "$SERVICE_NAME" >&2
    [ -n "$stop_output" ] && echo "Stop output: $stop_output"
    [ -n "$start_output" ] && echo "Start output: $start_output"

    # Show last log lines if available
    local log_file="/workspace/logs/${SERVICE_NAME}.log"
    if [ -f "$log_file" ]; then
      echo ""
      echo "Last 10 log lines:"
      tail -n 10 "$log_file" | sed 's/^/  /'
    fi
    exit 1
  fi
}

vite_build() {
  GUI_DIR="/workspace/gui"

  [ ! -d "$GUI_DIR" ] && error "GUI directory not found: $GUI_DIR"

  # Check if package.json exists
  if [ ! -f "$GUI_DIR/package.json" ]; then
    error "package.json not found in $GUI_DIR"
  fi

  info "Building Svelte GUI for production..."

  # Change to gui directory
  cd "$GUI_DIR"

  # Check if npm is available
  command -v npm >/dev/null 2>&1 || error "npm not found. Node.js not installed."

  # Check if node_modules exists
  if [ ! -d "node_modules" ]; then
    info "Dependencies not found. Running npm install..."
    npm install || error "npm install failed"
  fi

  # Run build
  npm run build || error "GUI build failed"

  # Check if build output exists
  if [ -d "static" ]; then
    success "Build complete. Output: $GUI_DIR/static"
  else
    warn "Build completed but static directory not found"
  fi

  cd /workspace
}

vite_start() {
  GUI_DIR="/workspace/gui"
  PID_FILE="/tmp/vite.pid"
  
  [ ! -d "$GUI_DIR" ] && error "GUI directory not found: $GUI_DIR"
  
  # Clear cache
  info "Clear vite cache..."
  rm -rf $GUI_DIR/node_modules/.vite
  
  # Check if already running
  if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE")
    if ps -p "$PID" > /dev/null 2>&1; then
      warn "Vite dev server is already running (PID: $PID)"
      return 0
    else
      rm -f "$PID_FILE"
    fi
  fi

  # Check if package.json exists
  if [ ! -f "$GUI_DIR/package.json" ]; then
    error "package.json not found in $GUI_DIR"
  fi

  # Check if npm is available
  command -v npm >/dev/null 2>&1 || error "npm not found. Node.js not installed."

  # Check if node_modules exists
  if [ ! -d "$GUI_DIR/node_modules" ]; then
    info "Dependencies not found. Running npm install..."
    cd "$GUI_DIR"
    npm install || error "npm install failed"
    cd /workspace
  fi

  info "Starting Vite dev server..."

  # Start vite in background and save PID
  cd "$GUI_DIR"
  nohup npm run dev > /workspace/logs/vite.log 2>&1 &
  echo $! > "$PID_FILE"
  cd /workspace

  sleep 2

  # Check if process is running
  if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE")
    if ps -p "$PID" > /dev/null 2>&1; then
      success "Vite dev server started (PID: $PID)"
      info "Access at: http://localhost:5173/"
      info "Logs: /workspace/logs/vite.log"
    else
      rm -f "$PID_FILE"
      error "Vite dev server failed to start. Check /workspace/logs/vite.log"
    fi
  fi
}

vite_stop() {
  PID_FILE="/tmp/vite.pid"

  if [ ! -f "$PID_FILE" ]; then
    warn "Vite dev server is not running (no PID file)"
    return 0
  fi

  PID=$(cat "$PID_FILE")

  if ! ps -p "$PID" > /dev/null 2>&1; then
    warn "Vite dev server is not running (stale PID file)"
    rm -f "$PID_FILE"
    return 0
  fi

  info "Stopping Vite dev server (PID: $PID)..."

  # Kill process and wait
  kill "$PID" 2>/dev/null || true
  sleep 2

  # Force kill if still running
  if ps -p "$PID" > /dev/null 2>&1; then
    warn "Process still running, forcing kill..."
    kill -9 "$PID" 2>/dev/null || true
    sleep 1
  fi

  rm -f "$PID_FILE"
  success "Vite dev server stopped"
}

vite_restart() {
  info "Restarting Vite dev server..."
  vite_stop
  sleep 1
  vite_start
}

vite_status() {
  PID_FILE="/tmp/vite.pid"

  echo ""
  echo "═══════════════════════════════════════════════════════════════════════════"
  echo "                      VITE DEV SERVER STATUS"
  echo "═══════════════════════════════════════════════════════════════════════════"
  echo ""

  if [ ! -f "$PID_FILE" ]; then
    echo "  Status: STOPPED (no PID file)"
    echo ""
    return 0
  fi

  PID=$(cat "$PID_FILE")

  if ! ps -p "$PID" > /dev/null 2>&1; then
    echo "  Status: STOPPED (stale PID file)"
    echo ""
    rm -f "$PID_FILE"
    return 0
  fi

  echo "  Status: RUNNING"
  echo "  PID: $PID"

  # Get process info
  CPU_MEM=$(ps -p "$PID" -o %cpu,%mem,etime --no-headers | awk '{print $1, $2, $3}')
  echo "  CPU/MEM/UPTIME: $CPU_MEM"
  echo "  URL: http://localhost:5173/"
  echo "  Logs: /workspace/logs/vite.log"
  echo ""
}

redis_status() {
  echo ""
  if redis-cli ping >/dev/null 2>&1; then
    echo "  Status: RUNNING"

    # Get Redis info
    REDIS_VERSION=$(redis-cli INFO server | grep "redis_version:" | cut -d':' -f2 | tr -d '\r')
    UPTIME=$(redis-cli INFO server | grep "uptime_in_seconds:" | cut -d':' -f2 | tr -d '\r')
    UPTIME_DAYS=$((UPTIME / 86400))
    UPTIME_HOURS=$(((UPTIME % 86400) / 3600))
    UPTIME_MINS=$(((UPTIME % 3600) / 60))

    CONNECTED_CLIENTS=$(redis-cli INFO clients | grep "connected_clients:" | cut -d':' -f2 | tr -d '\r')
    USED_MEMORY=$(redis-cli INFO memory | grep "used_memory_human:" | cut -d':' -f2 | tr -d '\r')
    TOTAL_KEYS=$(redis-cli DBSIZE | awk '{print $2}')

    echo "  Version: $REDIS_VERSION"
    echo "  Uptime: ${UPTIME_DAYS}d ${UPTIME_HOURS}h ${UPTIME_MINS}m"
    echo "  Connected clients: $CONNECTED_CLIENTS"
    echo "  Memory used: $USED_MEMORY"
    echo "  Total keys: $TOTAL_KEYS"
    echo ""
  else
    echo "  Status: STOPPED"
    echo ""
  fi
}

redis_info() {
  info "Redis keys information..."
  echo ""

  # Check if Redis is running
  if ! redis-cli ping >/dev/null 2>&1; then
    error "Redis server not running. Start it with 'cmd redis start'"
  fi

  # Get total number of keys
  TOTAL_KEYS=$(redis-cli DBSIZE | awk '{print $2}')

  if [ "$TOTAL_KEYS" = "0" ]; then
    info "No keys found in Redis"
    return 0
  fi

  echo "Total keys: $TOTAL_KEYS"
  echo ""
  echo "Keys list:"
  echo "─────────────────────────────────────────────────────────────────"

  # List all keys with their type and TTL
  redis-cli --scan | while read -r key; do
    KEY_TYPE=$(redis-cli TYPE "$key" | tr -d '\r')
    TTL=$(redis-cli TTL "$key" | tr -d '\r')

    if [ "$TTL" = "-1" ]; then
      TTL_INFO="no expiry"
    elif [ "$TTL" = "-2" ]; then
      TTL_INFO="key not found"
    else
      TTL_INFO="expires in ${TTL}s"
    fi

    printf "  %-50s [%s] (%s)\n" "$key" "$KEY_TYPE" "$TTL_INFO"
  done

  echo ""
}
# ============================================================================
# S6-OVERLAY SERVICE MANAGEMENT FUNCTIONS
# ============================================================================

S6_CMD="/command/s6-svc"
S6_STAT="/command/s6-svstat"
S6_SERVICE_DIR="/run/service"

s6_service_start() {
  local service="$1"
  local service_path="$S6_SERVICE_DIR/$service"

  if [ \! -d "$service_path" ]; then
    error "Service not found: $service"
  fi

  info "Starting $service service..."
  local cmd_output=$($S6_CMD -u "$service_path" 2>&1)
  sleep 1

  if $S6_STAT "$service_path" | grep -q "^up"; then
    success "$service started successfully"
  else
    printf 'ERROR: Failed to start %s\n' "$service" >&2
    [ -n "$cmd_output" ] && echo "Command output: $cmd_output"

    # Show last log lines if available
    local log_file="/workspace/logs/${service}.log"
    if [ -f "$log_file" ]; then
      echo ""
      echo "Last 10 log lines:"
      tail -n 10 "$log_file" | sed 's/^/  /'
    fi
    exit 1
  fi
}

s6_service_stop() {
  local service="$1"
  local service_path="$S6_SERVICE_DIR/$service"

  if [ \! -d "$service_path" ]; then
    error "Service not found: $service"
  fi

  info "Stopping $service service..."
  local cmd_output=$($S6_CMD -d "$service_path" 2>&1)
  sleep 1

  if $S6_STAT "$service_path" | grep -q "^down"; then
    success "$service stopped successfully"
  else
    printf 'ERROR: Failed to stop %s\n' "$service" >&2
    [ -n "$cmd_output" ] && echo "Command output: $cmd_output"

    # Show last log lines if available
    local log_file="/workspace/logs/${service}.log"
    if [ -f "$log_file" ]; then
      echo ""
      echo "Last 10 log lines:"
      tail -n 10 "$log_file" | sed 's/^/  /'
    fi
    exit 1
  fi
}

s6_service_restart() {
  local service="$1"
  local service_path="$S6_SERVICE_DIR/$service"

  if [ \! -d "$service_path" ]; then
    error "Service not found: $service"
  fi

  info "Restarting $service service..."
  local cmd_output=$($S6_CMD -r "$service_path" 2>&1)
  sleep 2

  if $S6_STAT "$service_path" | grep -q "^up"; then
    success "$service restarted successfully"
  else
    printf 'ERROR: Failed to restart %s\n' "$service" >&2
    [ -n "$cmd_output" ] && echo "Command output: $cmd_output"

    # Show last log lines if available
    local log_file="/workspace/logs/${service}.log"
    if [ -f "$log_file" ]; then
      echo ""
      echo "Last 10 log lines:"
      tail -n 10 "$log_file" | sed 's/^/  /'
    fi
    exit 1
  fi
}

s6_service_status() {
  local service="$1"
  local service_path="$S6_SERVICE_DIR/$service"
  
  if [ \! -d "$service_path" ]; then
    error "Service not found: $service"
  fi
  
  echo ""
  echo "═══════════════════════════════════════════════════════════════════════════"
  echo "                      $(echo $service | tr [:lower:] [:upper:]) SERVICE STATUS"
  echo "═══════════════════════════════════════════════════════════════════════════"
  echo ""
  
  local status_output=$($S6_STAT "$service_path")
  echo "  $status_output"
  echo ""
}

# Redis service functions
redis_start() {
  s6_service_start "redis"
}

redis_stop() {
  s6_service_stop "redis"
}

redis_restart() {
  s6_service_restart "redis"
}

