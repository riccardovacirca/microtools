# Gunicorn service functions (if managed by s6 in future)
# For now, keeping compatibility with existing scripts but adding note

# List all services and their status
service_list() {
  echo ""
  echo "═══════════════════════════════════════════════════════════════════════════"
  echo "                            S6 SERVICES STATUS"
  echo "═══════════════════════════════════════════════════════════════════════════"
  echo ""
  printf "%-20s %-15s %-40s\n" "SERVICE" "STATUS" "LOCATION"
  echo "───────────────────────────────────────────────────────────────────────────"

  # List enabled services from /etc/services.d/
  for service_dir in /etc/services.d/*/; do
    if [ -d "$service_dir" ]; then
      service_name=$(basename "$service_dir")
      printf "%-20s %-15s %-40s\n" "$service_name" "enabled" "$service_dir"
    fi
  done

  # List available (disabled) services from /etc/services.d.available/
  if [ -d "/etc/services.d.available" ]; then
    for service_dir in /etc/services.d.available/*/; do
      if [ -d "$service_dir" ]; then
        service_name=$(basename "$service_dir")
        # Skip if already enabled
        if [ ! -d "/etc/services.d/$service_name" ]; then
          printf "%-20s %-15s %-40s\n" "$service_name" "disabled" "$service_dir"
        fi
      fi
    done
  fi

  echo "═══════════════════════════════════════════════════════════════════════════"
  echo ""
  echo "Use 'cmd <service> start|stop|restart' to manage services at runtime"
  echo ""
}

# Check if service is running via s6
check_s6_service() {
  local service_name="$1"

  # Check if service directory exists and is enabled (no _ prefix)
  if [ -d "/etc/services.d/$service_name" ]; then
    # Service is enabled, check if supervised by s6
    if s6-svstat "/run/service/$service_name" >/dev/null 2>&1; then
      echo "running"
      return 0
    else
      echo "stopped"
      return 1
    fi
  else
    echo "disabled"
    return 1
  fi
}

# Updates a git repository
# Arguments:
#   $1: Directory path (e.g., /workspace or /workspace/.toolchain)
#   $2: Repository name (e.g., hello or webapp)
update_git_repo() {
  REPO_DIR="$1"
  REPO_NAME="$2"

  info "Updating repository in $REPO_DIR..."

  # Verify directory exists
  if [ ! -d "$REPO_DIR" ]; then
    warn "Directory $REPO_DIR does not exist, skipping"
    return 0
  fi

  # Check if it's a git repository
  if [ ! -d "$REPO_DIR/.git" ]; then
    warn "$REPO_DIR is not a git repository, skipping"
    return 0
  fi

  cd "$REPO_DIR"

  # Configure git
  git config --global --add safe.directory "$REPO_DIR" 2>/dev/null || true
  git config user.name "$GIT_USER"
  git config user.email "$GIT_EMAIL"
  git remote set-url origin "https://${GIT_USER}:${GIT_TOKEN}@github.com/riccardovacirca/${REPO_NAME}.git"

  # Stage changes
  info "  Staging changes in $REPO_DIR..."
  git add . || { warn "Failed to stage changes in $REPO_DIR"; cd /workspace; return 1; }

  # Commit changes
  info "  Creating commit in $REPO_DIR..."
  if git commit -m "updated" 2>/dev/null; then
    info "  Changes committed in $REPO_DIR"
  else
    info "  No changes to commit in $REPO_DIR"
    cd /workspace
    return 0
  fi

  # Push to remote
  info "  Pushing to remote from $REPO_DIR..."
  if git push 2>/dev/null; then
    info "  Successfully pushed $REPO_DIR"
  else
    warn "Failed to push changes from $REPO_DIR. Check credentials and network connection."
    cd /workspace
    return 1
  fi

  cd /workspace
}

# Pulls changes from git repositories
pull_git_repo() {
  REPO_DIR="$1"
  REPO_NAME="$2"

  info "Pulling repository in $REPO_DIR..."

  # Verify directory exists
  if [ ! -d "$REPO_DIR" ]; then
    warn "Directory $REPO_DIR does not exist, skipping"
    return 0
  fi

  # Check if it's a git repository
  if [ ! -d "$REPO_DIR/.git" ]; then
    warn "$REPO_DIR is not a git repository, skipping"
    return 0
  fi

  cd "$REPO_DIR"

  # Configure git
  git config --global --add safe.directory "$REPO_DIR" 2>/dev/null || true
  git config user.name "$GIT_USER"
  git config user.email "$GIT_EMAIL"
  git remote set-url origin "https://${GIT_USER}:${GIT_TOKEN}@github.com/riccardovacirca/${REPO_NAME}.git"

  # Pull from remote
  info "  Pulling from remote in $REPO_DIR..."
  if git pull 2>/dev/null; then
    info "  Successfully pulled $REPO_DIR"
  else
    warn "Failed to pull changes from $REPO_DIR. Check credentials and network connection."
    cd /workspace
    return 1
  fi

  cd /workspace
}

# Pushes git repositories in workspace and project directories
git_push() {
  load_env

  # Verify required environment variables
  [ -z "$GIT_USER" ] && error "GIT_USER not set in .env file"
  [ -z "$GIT_EMAIL" ] && error "GIT_EMAIL not set in .env file"
  [ -z "$GIT_TOKEN" ] && error "GIT_TOKEN not set in .env file (GitHub Personal Access Token required)"

  confirm "Push git repositories (workspace and project)?" || exit 0

  info "Starting git push..."

  # Update /workspace if it's a git repository
  if [ -d "/workspace/.git" ]; then
    update_git_repo "/workspace" "${PROJECT_NAME}"
  else
    info "/workspace is not a git repository, skipping"
  fi

  # Update /workspace/.toolchain if it's a git repository
  if [ -d "/workspace/.toolchain/.git" ]; then
    update_git_repo "/workspace/.toolchain" "microtools"
  else
    info "/workspace/.toolchain is not a git repository, skipping"
  fi

  info "Git push completed"
}

# Pulls changes from git repositories
git_pull() {
  load_env

  # Verify required environment variables
  [ -z "$GIT_USER" ] && error "GIT_USER not set in .env file"
  [ -z "$GIT_EMAIL" ] && error "GIT_EMAIL not set in .env file"
  [ -z "$GIT_TOKEN" ] && error "GIT_TOKEN not set in .env file (GitHub Personal Access Token required)"

  confirm "Pull git repositories (workspace and project)?" || exit 0

  info "Starting git pull..."

  # Pull /workspace if it's a git repository
  if [ -d "/workspace/.git" ]; then
    pull_git_repo "/workspace" "${PROJECT_NAME}"
  else
    info "/workspace is not a git repository, skipping"
  fi

  # Pull /workspace/.toolchain if it's a git repository
  if [ -d "/workspace/.toolchain/.git" ]; then
    pull_git_repo "/workspace/.toolchain" "microservice"
  else
    info "/workspace/.toolchain is not a git repository, skipping"
  fi

  info "Git pull completed"
}

# Syncs git repositories (pull, then push)
git_sync() {
  load_env

  # Verify required environment variables
  [ -z "$GIT_USER" ] && error "GIT_USER not set in .env file"
  [ -z "$GIT_EMAIL" ] && error "GIT_EMAIL not set in .env file"
  [ -z "$GIT_TOKEN" ] && error "GIT_TOKEN not set in .env file (GitHub Personal Access Token required)"

  confirm "Sync git repositories (pull + commit + push for workspace and project)?" || exit 0

  info "Starting git sync..."

  # Sync /workspace if it's a git repository
  if [ -d "/workspace/.git" ]; then
    pull_git_repo "/workspace" "${PROJECT_NAME}"
    update_git_repo "/workspace" "${PROJECT_NAME}"
  else
    info "/workspace is not a git repository, skipping"
  fi

  # Sync /workspace/.toolchain if it's a git repository
  if [ -d "/workspace/.toolchain/.git" ]; then
    pull_git_repo "/workspace/.toolchain" "microservice"
    update_git_repo "/workspace/.toolchain" "microservice"
  else
    info "/workspace/.toolchain is not a git repository, skipping"
  fi

  info "Git sync completed"
}

# Creates or switches to a branch and pushes to remote if needed
# Arguments:
#   $1: Branch name
#   $2: Repository name (optional: empty=workspace, 'microtools'=.toolchain, or custom path)
git_branch() {
  BRANCH_NAME="$1"
  REPO_SPEC="$2"
  load_env

  [ -z "$BRANCH_NAME" ] && error "Branch name is required. Use: cmd git branch -b <branch-name> [<repo-name>]"

  # Verify required environment variables
  [ -z "$GIT_USER" ] && error "GIT_USER not set in .env file"
  [ -z "$GIT_EMAIL" ] && error "GIT_EMAIL not set in .env file"
  [ -z "$GIT_TOKEN" ] && error "GIT_TOKEN not set in .env file (GitHub Personal Access Token required)"

  # Determine repository directory and name
  if [ -z "$REPO_SPEC" ]; then
    # Default: /workspace
    REPO_DIR="/workspace"
    REPO_NAME="${PROJECT_NAME}"
  elif [ "$REPO_SPEC" = "microtools" ]; then
    # microtools: /workspace/.toolchain
    REPO_DIR="/workspace/.toolchain"
    REPO_NAME="microtools"
  else
    # Custom path
    REPO_DIR="$REPO_SPEC"
    REPO_NAME=$(basename "$REPO_DIR")
  fi

  # Verify directory exists and is a git repo
  if [ ! -d "$REPO_DIR" ]; then
    error "Directory $REPO_DIR does not exist"
  fi

  if [ ! -d "$REPO_DIR/.git" ]; then
    error "$REPO_DIR is not a git repository"
  fi

  info "Processing branch '$BRANCH_NAME' in $REPO_DIR..."

  cd "$REPO_DIR"

  # Configure git
  git config --global --add safe.directory "$REPO_DIR" 2>/dev/null || true
  git config user.name "$GIT_USER"
  git config user.email "$GIT_EMAIL"
  git remote set-url origin "https://${GIT_USER}:${GIT_TOKEN}@github.com/riccardovacirca/${REPO_NAME}.git"

  # Check if branch exists locally
  if git show-ref --verify --quiet "refs/heads/$BRANCH_NAME"; then
    info "  Branch '$BRANCH_NAME' exists locally, switching..."
    git switch "$BRANCH_NAME" || { error "Failed to switch to branch in $REPO_DIR"; }
  else
    info "  Branch '$BRANCH_NAME' does not exist locally, creating..."
    git switch -c "$BRANCH_NAME" || { error "Failed to create branch in $REPO_DIR"; }
  fi

  # Check if branch exists on remote
  if ! git ls-remote --exit-code --heads origin "$BRANCH_NAME" >/dev/null 2>&1; then
    info "  Branch '$BRANCH_NAME' does not exist on remote, pushing..."
    if git push -u origin "$BRANCH_NAME" 2>/dev/null; then
      success "Branch '$BRANCH_NAME' pushed to remote in $REPO_DIR"
    else
      warn "Failed to push branch to remote in $REPO_DIR"
      cd /workspace
      return 1
    fi
  else
    info "  Branch '$BRANCH_NAME' already exists on remote"
  fi

  cd /workspace
  success "Git branch operation completed for '$BRANCH_NAME' in $REPO_DIR"
}

# Merges a branch into main and deletes it from local and remote
# Arguments:
#   $1: Branch name
#   $2: Repository name (optional: empty=workspace, 'microtools'=.toolchain, or custom path)
git_merge() {
  BRANCH_NAME="$1"
  REPO_SPEC="$2"
  load_env

  [ -z "$BRANCH_NAME" ] && error "Branch name is required. Use: cmd git merge -b <branch-name> [<repo-name>]"

  # Verify required environment variables
  [ -z "$GIT_USER" ] && error "GIT_USER not set in .env file"
  [ -z "$GIT_EMAIL" ] && error "GIT_EMAIL not set in .env file"
  [ -z "$GIT_TOKEN" ] && error "GIT_TOKEN not set in .env file (GitHub Personal Access Token required)"

  # Prevent merging main/master into themselves
  if [ "$BRANCH_NAME" = "main" ] || [ "$BRANCH_NAME" = "master" ]; then
    error "Cannot merge main/master branch into itself"
  fi

  # Determine repository directory and name
  if [ -z "$REPO_SPEC" ]; then
    # Default: /workspace
    REPO_DIR="/workspace"
    REPO_NAME="${PROJECT_NAME}"
  elif [ "$REPO_SPEC" = "microtools" ]; then
    # microtools: /workspace/.toolchain
    REPO_DIR="/workspace/.toolchain"
    REPO_NAME="microtools"
  else
    # Custom path
    REPO_DIR="$REPO_SPEC"
    REPO_NAME=$(basename "$REPO_DIR")
  fi

  # Verify directory exists and is a git repo
  if [ ! -d "$REPO_DIR" ]; then
    error "Directory $REPO_DIR does not exist"
  fi

  if [ ! -d "$REPO_DIR/.git" ]; then
    error "$REPO_DIR is not a git repository"
  fi

  confirm "Merge branch '$BRANCH_NAME' into main and delete it from local and remote in $REPO_DIR?" || exit 0

  info "Processing merge of '$BRANCH_NAME' in $REPO_DIR..."

  cd "$REPO_DIR"

  # Configure git
  git config --global --add safe.directory "$REPO_DIR" 2>/dev/null || true
  git config user.name "$GIT_USER"
  git config user.email "$GIT_EMAIL"
  git remote set-url origin "https://${GIT_USER}:${GIT_TOKEN}@github.com/riccardovacirca/${REPO_NAME}.git"

  # Detect main branch name (main or master)
  MAIN_BRANCH="main"
  if git show-ref --verify --quiet "refs/heads/master"; then
    if ! git show-ref --verify --quiet "refs/heads/main"; then
      MAIN_BRANCH="master"
    fi
  fi

  # Check if branch exists locally
  if ! git show-ref --verify --quiet "refs/heads/$BRANCH_NAME"; then
    error "Branch '$BRANCH_NAME' does not exist locally in $REPO_DIR"
  fi

  # Switch to main branch
  info "  Switching to '$MAIN_BRANCH' branch..."
  git switch "$MAIN_BRANCH" || { error "Failed to switch to $MAIN_BRANCH in $REPO_DIR"; }

  # Merge the branch
  info "  Merging '$BRANCH_NAME' into '$MAIN_BRANCH'..."
  if git merge "$BRANCH_NAME" --no-edit 2>/dev/null; then
    success "Branch '$BRANCH_NAME' merged successfully in $REPO_DIR"
  else
    error "Merge failed in $REPO_DIR. Resolve conflicts manually."
  fi

  # Delete branch locally
  info "  Deleting local branch '$BRANCH_NAME'..."
  if git branch -d "$BRANCH_NAME" 2>/dev/null; then
    info "  Local branch '$BRANCH_NAME' deleted"
  else
    warn "Failed to delete local branch '$BRANCH_NAME' (use -D to force delete if needed)"
  fi

  # Delete branch from remote if it exists
  if git ls-remote --exit-code --heads origin "$BRANCH_NAME" >/dev/null 2>&1; then
    info "  Deleting remote branch '$BRANCH_NAME'..."
    if git push origin --delete "$BRANCH_NAME" 2>/dev/null; then
      success "Remote branch '$BRANCH_NAME' deleted from $REPO_DIR"
    else
      warn "Failed to delete remote branch '$BRANCH_NAME' from $REPO_DIR"
    fi
  else
    info "  Branch '$BRANCH_NAME' does not exist on remote"
  fi

  cd /workspace

  info "Git merge operation completed for '$BRANCH_NAME' in $REPO_DIR"
  info "Note: Changes have been merged locally but not pushed to remote"
  info "Use 'cmd git push' to push the merged changes to remote"
}

# Exports a module to a tar.gz archive
# Arguments:
#   $1: Module name
module_export() {
  MODULE_NAME="$1"

  [ -z "$MODULE_NAME" ] && error "Module name is required. Use: cmd module export -n <module-name>"

  # Check if API module exists (required)
  API_DIR="/workspace/api/$MODULE_NAME"
  if [ ! -d "$API_DIR" ]; then
    error "Module '$MODULE_NAME' not found. API directory is required: $API_DIR"
  fi

  info "Exporting module '$MODULE_NAME'..."

  # Create dist directory structure
  DIST_DIR="/workspace/dist/modules"
  MODULE_DIST_DIR="$DIST_DIR/$MODULE_NAME"
  mkdir -p "$MODULE_DIST_DIR"

  # Clean previous export if exists
  rm -rf "$MODULE_DIST_DIR"/*

  # Export API (required)
  info "  Exporting API..."
  cp -r "$API_DIR" "$MODULE_DIST_DIR/api"

  # Check and export optional components
  HAS_DATABASE=false
  HAS_GUI=false
  HAS_SERVICE=false

  # Export Database (optional)
  DB_DIR="/workspace/database/$MODULE_NAME"
  if [ -d "$DB_DIR" ]; then
    info "  Exporting Database..."
    cp -r "$DB_DIR" "$MODULE_DIST_DIR/database"
    HAS_DATABASE=true
  else
    info "  Database not found, skipping"
  fi

  # Export GUI (optional)
  GUI_DIR="/workspace/gui/src/$MODULE_NAME"
  if [ -d "$GUI_DIR" ]; then
    info "  Exporting GUI..."
    cp -r "$GUI_DIR" "$MODULE_DIST_DIR/gui"
    HAS_GUI=true
  else
    info "  GUI not found, skipping"
  fi

  # Export Service (optional)
  SERVICE_DIR="/workspace/services/$MODULE_NAME"
  if [ -d "$SERVICE_DIR" ]; then
    info "  Exporting Service..."
    mkdir -p "$MODULE_DIST_DIR/service"

    # Copy source files, exclude build artifacts
    if [ -d "$SERVICE_DIR/src" ]; then
      cp -r "$SERVICE_DIR/src" "$MODULE_DIST_DIR/service/"
    fi

    # Copy configuration files
    [ -f "$SERVICE_DIR/CMakeLists.txt" ] && cp "$SERVICE_DIR/CMakeLists.txt" "$MODULE_DIST_DIR/service/"
    [ -f "$SERVICE_DIR/.env.example" ] && cp "$SERVICE_DIR/.env.example" "$MODULE_DIST_DIR/service/"

    HAS_SERVICE=true
  else
    info "  Service not found, skipping"
  fi

  # Create module.json with metadata
  info "  Creating module.json..."

  # Extract Python dependencies from API
  PYTHON_DEPS="[]"
  if [ -f "$API_DIR/requirements.txt" ]; then
    # Convert requirements.txt to JSON array
    PYTHON_DEPS=$(cat "$API_DIR/requirements.txt" | grep -v "^#" | grep -v "^$" | awk '{printf "\"%s\",", $1}' | sed 's/,$//')
    PYTHON_DEPS="[$PYTHON_DEPS]"
  fi

  # Create README from workflow.md if exists
  if [ -f "$API_DIR/workflow.md" ]; then
    info "  Copying workflow.md as README.md..."
    cp "$API_DIR/workflow.md" "$MODULE_DIST_DIR/README.md"
  fi

  # Generate module.json
  cat > "$MODULE_DIST_DIR/module.json" <<EOF
{
  "name": "$MODULE_NAME",
  "version": "1.0.0",
  "description": "Module $MODULE_NAME",
  "author": "Generated by Microtools",
  "exported_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "dependencies": {
    "python": $PYTHON_DEPS,
    "system": []
  },
  "components": {
    "api": true,
    "database": $HAS_DATABASE,
    "gui": $HAS_GUI,
    "service": $HAS_SERVICE
  }
}
EOF

  # Create tar.gz archive
  info "  Creating archive..."
  cd "$DIST_DIR"
  tar -czf "${MODULE_NAME}.tar.gz" "$MODULE_NAME" || error "Failed to create archive"
  cd /workspace

  # Cleanup temporary directory
  rm -rf "$MODULE_DIST_DIR"

  ARCHIVE_SIZE=$(du -h "$DIST_DIR/${MODULE_NAME}.tar.gz" | cut -f1)
  success "Module '$MODULE_NAME' exported successfully"
  info "Archive: $DIST_DIR/${MODULE_NAME}.tar.gz ($ARCHIVE_SIZE)"
}

# Imports a module from a tar.gz archive
# Arguments:
#   $1: Module archive name (e.g., mod_status.tar.gz)
#   $2: Force flag (--force)
module_import() {
  ARCHIVE_NAME="$1"
  FORCE_FLAG="$2"

  [ -z "$ARCHIVE_NAME" ] && error "Archive name is required. Use: cmd module import -n <module-name>.tar.gz [--force]"

  # Ensure .tar.gz extension
  if [ "${ARCHIVE_NAME%.tar.gz}" = "$ARCHIVE_NAME" ]; then
    ARCHIVE_NAME="${ARCHIVE_NAME}.tar.gz"
  fi

  DIST_DIR="/workspace/dist/modules"
  ARCHIVE_PATH="$DIST_DIR/$ARCHIVE_NAME"

  # Check if archive exists
  if [ ! -f "$ARCHIVE_PATH" ]; then
    error "Archive not found: $ARCHIVE_PATH"
  fi

  info "Importing module from $ARCHIVE_NAME..."

  # Extract module name from archive
  MODULE_NAME="${ARCHIVE_NAME%.tar.gz}"

  # Check if module already exists
  API_DIR="/workspace/api/$MODULE_NAME"
  if [ -d "$API_DIR" ]; then
    if [ "$FORCE_FLAG" != "--force" ]; then
      error "Module '$MODULE_NAME' already exists in $API_DIR. Use --force to overwrite."
    else
      warn "Module '$MODULE_NAME' exists. Overwriting due to --force flag..."
    fi
  fi

  # Extract archive to temporary location
  TMP_EXTRACT="/tmp/module_import_$$"
  mkdir -p "$TMP_EXTRACT"

  info "  Extracting archive..."
  tar -xzf "$ARCHIVE_PATH" -C "$TMP_EXTRACT" || error "Failed to extract archive"

  MODULE_EXTRACT_DIR="$TMP_EXTRACT/$MODULE_NAME"

  # Verify module.json exists
  if [ ! -f "$MODULE_EXTRACT_DIR/module.json" ]; then
    rm -rf "$TMP_EXTRACT"
    error "Invalid module archive: module.json not found"
  fi

  # Read module.json
  info "  Reading module metadata..."
  MODULE_JSON=$(cat "$MODULE_EXTRACT_DIR/module.json")

  # Import API (required)
  if [ -d "$MODULE_EXTRACT_DIR/api" ]; then
    info "  Importing API..."
    [ -d "$API_DIR" ] && rm -rf "$API_DIR"
    cp -r "$MODULE_EXTRACT_DIR/api" "$API_DIR"
  else
    rm -rf "$TMP_EXTRACT"
    error "Invalid module archive: API directory not found"
  fi

  # Import Database (if exists)
  if [ -d "$MODULE_EXTRACT_DIR/database" ]; then
    info "  Importing Database..."
    DB_DIR="/workspace/database/$MODULE_NAME"
    [ -d "$DB_DIR" ] && rm -rf "$DB_DIR"
    cp -r "$MODULE_EXTRACT_DIR/database" "$DB_DIR"
  fi

  # Import GUI (if exists)
  if [ -d "$MODULE_EXTRACT_DIR/gui" ]; then
    info "  Importing GUI..."
    GUI_DIR="/workspace/gui/src/$MODULE_NAME"
    [ -d "$GUI_DIR" ] && rm -rf "$GUI_DIR"
    cp -r "$MODULE_EXTRACT_DIR/gui" "$GUI_DIR"
  fi

  # Import Service (if exists)
  if [ -d "$MODULE_EXTRACT_DIR/service" ]; then
    info "  Importing Service..."
    SERVICE_DIR="/workspace/services/$MODULE_NAME"
    [ -d "$SERVICE_DIR" ] && rm -rf "$SERVICE_DIR"
    mkdir -p "$SERVICE_DIR"
    cp -r "$MODULE_EXTRACT_DIR/service/"* "$SERVICE_DIR/"
  fi

  # Cleanup
  rm -rf "$TMP_EXTRACT"

  success "Module '$MODULE_NAME' imported successfully"

  # Suggest post-import operations
  echo ""
  echo "═══════════════════════════════════════════════════════════════════════════"
  echo "                         POST-IMPORT SETUP"
  echo "═══════════════════════════════════════════════════════════════════════════"
  echo ""

  # Check for Python dependencies
  PYTHON_DEPS=$(echo "$MODULE_JSON" | grep -o '"python":\s*\[[^]]*\]' | sed 's/"python":\s*\[//;s/\]//' | sed 's/"//g')
  if [ -n "$PYTHON_DEPS" ] && [ "$PYTHON_DEPS" != " " ]; then
    echo "Python dependencies detected:"
    echo "$PYTHON_DEPS" | tr ',' '\n' | sed 's/^/  - /'
    echo ""
    echo "To install Python dependencies, run:"
    echo "  pip install $PYTHON_DEPS"
    echo ""
  fi

  # Check if service needs building
  if [ -d "/workspace/services/$MODULE_NAME" ]; then
    echo "C++ microservice detected:"
    echo "  To build the service, run:"
    echo "    cmd service build -n $MODULE_NAME"
    echo "  To enable and start the service, run:"
    echo "    cmd service enable -n $MODULE_NAME"
    echo ""
  fi

  # Check if database scripts exist
  if [ -d "/workspace/database/$MODULE_NAME" ]; then
    echo "Database scripts detected:"
    echo "  To install database schema, run:"
    echo "    cmd db -f /workspace/database/$MODULE_NAME/<db_type>_install.sql"
    echo "  (Replace <db_type> with: sqlite3, mariadb, or postgres)"
    echo ""
  fi

  # Check if GUI needs rebuilding
  if [ -d "/workspace/gui/src/$MODULE_NAME" ]; then
    echo "GUI components detected:"
    echo "  You may need to update /workspace/gui/src/Layout.svelte to include the new module"
    echo "  To rebuild the GUI, run:"
    echo "    cmd vite build"
    echo ""
  fi

  echo "═══════════════════════════════════════════════════════════════════════════"
  echo ""
}

