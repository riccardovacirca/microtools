{
  "dsl_name": "microtools_python_class_style",
  "version": "2.0",
  "description": "DSL per lo stile di codifica delle classi Python utility",

  "naming_conventions": {
    "classes": {
      "style": "PascalCase",
      "examples": ["DB", "DBConnPool", "Env", "Redis"]
    },
    "methods": {
      "public": {
        "style": "camelCase",
        "examples": ["acquire()", "release()", "hasConnection()", "cursorOpen()", "getPoolStatus()"]
      },
      "private": {
        "style": "_camelCase",
        "examples": ["_detectDriver()", "_buildConfig()", "_createEngine()", "_stripQuotes()"]
      }
    },
    "attributes": {
      "style": "_camelCase (all private)",
      "examples": ["_connection", "_pool", "_cursor", "_cursorResult", "_columns", "_client"]
    },
    "local_variables": {
      "style": "camelCase",
      "examples": ["retv", "connStr", "dbPath", "poolSize", "checkedOut"]
    }
  },

  "formatting": {
    "indentation": {
      "style": "4_spaces",
      "reason": "Standard Python PEP8"
    },
    "blank_lines": {
      "between_methods": 1,
      "between_classes": 2,
      "inside_method_body": "minimal, only for logical separation"
    },
    "docstrings": {
      "style": "single_line_only",
      "format": "\"\"\"Brief description.\"\"\"",
      "mandatory_for": ["classes", "all_methods"]
    }
  },

  "type_hints": {
    "mandatory": true,
    "modern_syntax": "use | for unions (Python 3.10+)",
    "examples": [
      "def query(self, sql: str, params: tuple = None) -> int | None:",
      "def select(self, sql: str, params: tuple = None) -> List[Dict[str, Any]]:",
      "def hasConnection(self) -> bool:"
    ]
  },

  "control_flow": {
    "single_exit_point": {
      "mandatory": true,
      "pattern": "retv = default_value ... return retv",
      "example": [
        "def cursorHasNext(self) -> bool:",
        "    retv = False",
        "    if self._cursorResult is not None:",
        "        retv = self._cursorIndex < len(self._cursorResult)",
        "    return retv"
      ]
    },
    "traditional_style": {
      "mandatory": true,
      "forbidden": ["list_comprehensions", "dict_comprehensions", "ternary_expressions"],
      "use_instead": ["for loops with append", "explicit if/else blocks"]
    }
  },

  "constructor": {
    "pattern": "def __init__(self):",
    "docstring": "single line",
    "initialization": "all attributes private with underscore",
    "example": [
      "def __init__(self):",
      "    \"\"\"Initialize DB handler.\"\"\"",
      "    self._connection = None",
      "    self._pool = None",
      "    self._cursor = None"
    ]
  },

  "method_structure": {
    "preconditions": "guard clauses with raise at top",
    "variables": "initialize retv at start for methods with return",
    "logic": "traditional style, no comprehensions",
    "return": "single return statement at end",
    "example": [
      "def select(self, sql: str, params: tuple = None) -> List[Dict[str, Any]]:",
      "    \"\"\"Execute SELECT query and return list of dict.\"\"\"",
      "    if not self.hasConnection():",
      "        raise RuntimeError('Not connected')",
      "    retv = []",
      "    cursor = self._connection.cursor()",
      "    try:",
      "        if params:",
      "            cursor.execute(sql, params)",
      "        else:",
      "            cursor.execute(sql)",
      "        rows = cursor.fetchall()",
      "        if rows:",
      "            cols = []",
      "            for col in cursor.description:",
      "                cols.append(col[0])",
      "            for row in rows:",
      "                record = {}",
      "                for i in range(len(cols)):",
      "                    record[cols[i]] = row[i]",
      "                retv.append(record)",
      "    finally:",
      "        cursor.close()",
      "    return retv"
    ]
  },

  "context_managers": {
    "use_enter_exit": true,
    "pattern": [
      "def __enter__(self):",
      "    \"\"\"Context manager entry.\"\"\"",
      "    return self",
      "",
      "def __exit__(self, exc_type, exc_val, exc_tb):",
      "    \"\"\"Context manager exit.\"\"\"",
      "    self.release()"
    ]
  },

  "error_handling": {
    "preconditions": "raise RuntimeError/ValueError at method start",
    "try_except": "single level, no nesting",
    "except_block": "catch Exception, not bare except",
    "patterns": {
      "state_validation": "if not self.hasConnection():\n    raise RuntimeError('Not connected')",
      "resource_cleanup": "try/finally for cursor.close()"
    }
  },

  "imports": {
    "order": ["standard library", "third party", "local imports"],
    "typing": "from typing import Dict, List, Any",
    "alias_for_conflicts": "import redis as redisLib"
  },

  "forbidden_patterns": [
    "list_comprehensions",
    "dict_comprehensions",
    "ternary_expressions (x if cond else y)",
    "multiple_return_statements",
    "public_attributes",
    "multi_line_docstrings",
    "nested_try_except",
    "bare_except"
  ],

  "required_patterns": [
    "single_exit_point",
    "retv_variable_for_returns",
    "traditional_for_loops",
    "private_attributes_only",
    "single_line_docstrings",
    "camelCase_methods",
    "guard_clauses_with_raise"
  ]
}
