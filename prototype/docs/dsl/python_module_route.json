{
  "api_style": "fastapi_explicit_starlette_servlet",
  "routing": {
    "router": {
      "type": "APIRouter",
      "prefix": {
        "mandatory": true,
        "pattern": "/<module_name_without_mod_prefix>",
        "derivation": "mod_<name> -> /<name>",
        "examples": {
          "mod_status": "/status",
          "mod_risorse": "/risorse",
          "mod_auth": "/auth"
        }
      },
      "tags": {
        "mandatory": true,
        "pattern": "[\"<module_name_without_mod_prefix>\"]",
        "examples": ["status", "risorse", "auth"]
      },
      "declaration": "router = APIRouter(prefix=\"/<module>\", tags=[\"<module>\"])"
    },
    "registration": "decorators_only",
    "allow_global_routes": false,
    "path_convention": {
      "pattern": "/<entity_name>",
      "note": "prefix is already set on router, paths are relative",
      "entity_name": "nome dell'entità al plurale (es. contatti, liste, campagne)",
      "full_url": "/api/<module>/<entity> (when mounted on /api)",
      "examples": [
        "@router.get(\"/info\") -> /status/info",
        "@router.get(\"/contatti\") -> /risorse/contatti",
        "@router.get(\"/contatti/{id}\") -> /risorse/contatti/{id}"
      ],
      "crud_paths": {
        "list": "GET /<entity>",
        "create": "POST /<entity>",
        "read": "GET /<entity>/{id}",
        "update": "PUT /<entity>/{id}",
        "delete": "DELETE /<entity>/{id}",
        "nested": "GET /<entity>/{id}/<sub_entity>"
      }
    }
  },
  "handlers": {
    "async_only": true,
    "naming": "camelCase",
    "request_usage": {
      "import_only_if_used": true,
      "use_for_body_parsing": "request.json()",
      "use_for_pool_access": "request.app.state.db_pool",
      "servlet_style": true
    },
    "allow_depends": false,
    "allow_pydantic_in_signature": false
  },
  "architecture": {
    "handler_logic": "delegate_to_services",
    "service_return_type": "response_model_dict",
    "handler_responsibility": "http_layer_only"
  },
  "responses": {
    "type": "JSONResponse",
    "parameters": "positional_allowed",
    "status_code": "explicit_required",
    "allow_http_exception": false
  },
  "error_handling": {
    "strategy": "check_err_flag",
    "success_status": 200,
    "error_status": 503,
    "return_format": "complete_response_model"
  },
  "response_structure": {
    "always_return": "complete_response_model_dict",
    "fields": ["err", "log", "out"],
    "never_extract_fields": true
  },
  "function_parameters": {
    "rule": "no_default_values",
    "rationale": "explicit over implicit",
    "forbidden": "async def handler(request: Request = None)",
    "required": "async def handler(request: Request)"
  },
  "forbidden": [
    "response_model_decorator",
    "implicit_body_parsing_via_pydantic",
    "implicit_status_codes",
    "HTTPException",
    "unused_imports",
    "default_parameter_values",
    "router_without_prefix"
  ],
  "example": {
    "file": "mod_risorse/routes.py",
    "code": [
      "from fastapi import APIRouter, Request",
      "from fastapi.responses import JSONResponse",
      "from .services import contatto_service",
      "",
      "router = APIRouter(prefix=\"/risorse\", tags=[\"risorse\"])",
      "",
      "@router.get(\"/contatti\")",
      "async def getContatti(request: Request):",
      "    \"\"\"Recupera tutti i contatti.\"\"\"",
      "    pool = request.app.state.db_pool",
      "    data = await contatto_service.getAll(pool)",
      "    if data[\"err\"]:",
      "        return JSONResponse(data, 503)",
      "    return JSONResponse(data, 200)"
    ]
  }
}
