PROJECT_NAME={{PROJECT_NAME}}

# Package metadata
VERSION=1.0.0
MAINTAINER="{{PROJECT_NAME}} Team <admin@example.com>"
DESCRIPTION="{{PROJECT_NAME}} HTTP Microservice"
SECTION=web
PRIORITY=optional
ARCHITECTURE=amd64

# Network configuration
HOST=127.0.0.1
PORT=9000
TLS_PORT=2320

# Performance tuning
POLL_INTERVAL=1000
THREAD_COUNT=10

# Logging and file management
LOG_FILE=/var/log/{{PROJECT_NAME}}.log
UNIX_SOCKET=/tmp/{{PROJECT_NAME}}
UPLOAD_DIR=/var/lib/{{PROJECT_NAME}}/uploads
PID_FILE=/run/{{PROJECT_NAME}}.pid

# TLS configuration
TLS_CERT_FILE=""
TLS_KEY_FILE=""

# Container environment
UBUNTU_IMAGE={{PROJECT_NAME}}-dev:latest
NETWORK={{PROJECT_NAME}}-net
DB_READY_TIMEOUT=120

# Database connection pool
DB_POOL_SIZE=10

# Git configuration
GIT_USER=""
GIT_EMAIL=""
GIT_TOKEN=""

# Production configuration
PROD_HOST=127.0.0.1
PROD_PORT=9000
PROD_DB_CONNECTION=file:/opt/{{PROJECT_NAME}}/{{PROJECT_NAME}}.db
PROD_LOG_FILE=/var/log/{{PROJECT_NAME}}.log
PROD_UPLOAD_DIR=/opt/{{PROJECT_NAME}}/uploads
PROD_PID_FILE=/run/{{PROJECT_NAME}}.pid
PROD_DEPS="libc6, libapr1t64, libaprutil1t64, libjson-c5, libcurl4t64, sqlite3, python3, python3-pip"
PROD_API_PORT=8000
PROD_API_HOST=0.0.0.0
PROD_API_EXTERNAL_PORT=80
PROD_STATIC_DIR=/opt/{{PROJECT_NAME}}/static

# Database drivers (enable/disable before running setup.sh)
SQLITE3_ENABLED="y"
MARIADB_ENABLED="n"
PGSQL_ENABLED="n"

# SQLite3 (embedded database, active by default)
SQLITE3_DRIVER="sqlite3"
SQLITE3_DATA_PATH="/var/lib/sqlite3"
SQLITE3_CONNECTION="file:/workspace/data/{{PROJECT_NAME}}.db"

# MariaDB/MySQL (external container: <project>-mariadb)
MARIADB_DRIVER="mariadb"
MARIADB_CONNECTION="host={{PROJECT_NAME}}-mariadb,port=3306,user={{PROJECT_NAME}},pass=secret,dbname={{PROJECT_NAME}}"
MARIADB_IMAGE=mariadb:latest
MARIADB_CONTAINER={{PROJECT_NAME}}-mariadb
MARIADB_VOLUME={{PROJECT_NAME}}-mariadb-data
MARIADB_USER={{PROJECT_NAME}}
MARIADB_PASSWORD=secret
MARIADB_ROOT_USER=root
MARIADB_ROOT_PASSWORD=root
MARIADB_NAME={{PROJECT_NAME}}
MARIADB_PORT=2330

# PostgreSQL (external container: <project>-postgres)
PGSQL_DRIVER="pgsql"
PGSQL_CONNECTION="host={{PROJECT_NAME}}-postgres port=5432 user={{PROJECT_NAME}} password=secret dbname={{PROJECT_NAME}}"
PGSQL_IMAGE=postgres:latest
PGSQL_CONTAINER={{PROJECT_NAME}}-postgres
PGSQL_VOLUME={{PROJECT_NAME}}-postgres-data
PGSQL_USER={{PROJECT_NAME}}
PGSQL_PASSWORD=secret
PGSQL_ROOT_USER=postgres
PGSQL_ROOT_PASSWORD=postgres
PGSQL_NAME={{PROJECT_NAME}}
PGSQL_PORT=2340

# Vite/Svelte
VITE_PORT=2350
GUI_FRAMEWORK=svelte

# FastAPI API (Development) - porte 8000+
API_PORT=2310
API_HOST=0.0.0.0
API_EXTERNAL_PORT=2310
STATIC_DIR=/workspace/gui/static
API_PID_FILE=/tmp/{{PROJECT_NAME}}-api.pid
GUI_PID_FILE=/tmp/{{PROJECT_NAME}}-gui.pid

# Microservices C++ (porte 9000+)
MOD_STATUS_PORT=9001
MOD_STATUS_HOST=127.0.0.1

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Database DSN
DB_DSN=DSN={{PROJECT_NAME}}

# Gunicorn configuration (for testing in development)
GUNICORN_PORT=8001
GUNICORN_HOST=127.0.0.1
